@using SPSUL.Models.Data
@using SPSUL.Models.Display.StudentModels
@model StudentIndexVM

@{
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";
    ViewData["Title"] = "Studenti";

    var canCrudStudents = Context.HasAnyPermission(AppPermissions.CrudStudents, AppPermissions.ManageStudents, AppPermissions.All);
}
<link rel="stylesheet" href="~/css/normalTables.css" asp-append-version="true"/>

<div class="container-fluid py-3">
    <div class="row g-3">
        <div class="col-lg-9 order-2 order-lg-1">
            <div class="card shadow-sm cardTable">
                <div class="card-header brandText d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-people-fill me-2"></i>
                        Seznam studentů
                    </h5>
                    <div class="tools d-flex justify-content-center align-items-center gap-2">
                        <!--Cancel-->
                        <a class="iconLink cursor option" id="cancelOption" style="display: none">
                            <i class="bi bi-dash-circle"></i>
                            Zrušit
                        </a>
                        <!--Confirm-->
                        <a class="iconLink cursor option" id="acceptOption" style="display: none">
                            <i class="bi bi-plus-circle"></i>
                            Potvrdit
                        </a>
                        <!--Export-->
                        <a class="iconLink cursor mode" title="Exportovat do PDF" id="exportBtn">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Export PDF
                        </a>
                        @if (canCrudStudents)
                        {
                        <!--Activate-->
                        <a class="iconLink cursor mode" title="Aktivovat studenty" id="activate" data-endpoint="Students/Activate/" data-method="POST">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                            Aktivace
                        </a>
                        <!--Deactivate-->
                        <a class="iconLink cursor mode" title="Deaktivovat studenty" id="deactivateMode" data-endpoint="Students/Deactivate/" data-method="POST">
                            <i class="bi bi-arrow-down-circle-fill"></i>
                            Deaktivace
                        </a>
                        <!--Delete Mode-->
                        <a class="iconLink cursor mode" title="Smazat studenty" id="deleteMode" data-endpoint="Students/Delete/" data-method="POST">
                            <i class="bi bi-dash-circle"></i>
                            Smazat
                        </a>
                        <!--Bulk Create-->
                        <a class="iconLink cursor mode" title="Hromadné vytvoření" id="bulkCreateBtn">
                            <i class="bi bi-people-fill"></i>
                            Hromadně vytvořit
                        </a>
                        }
                    </div>
                </div>
                <div class="table-responsive tableContent">
                    <table class="table align-middle mb-0" style="min-width: 1000px">
                        <thead>
                            <tr>
                                <th class="col-2">Jméno</th>
                                <th class="col-2">Příjmení</th>
                                <th class="col-2">Třída</th>
                                <th class="col-2">Obor</th>
                                <th class="col-1">Aktivní</th>
                                @if (canCrudStudents)
                                {
                                <th class="col-1 text-center" id="editHeader" style="display:table-cell">Edit</th>
                                <th class="col-1 d-none" id="deleteHeader">Smazat</th>
                                <th class="col-1 d-none" id="deactivateHeader">Deaktivace</th>
                                <th class="col-1 d-none" id="activateHeader">Aktivace</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Students)
                            {
                                var classNames = s.ClassesStudents?.Select(cs => cs.Classes?.Name).Where(n => n != null);
                                var fieldNames = s.ClassesStudents?
                                    .SelectMany(cs => cs.Classes?.ClassesFields?.Select(cf => cf.StudentField?.Name) ?? Enumerable.Empty<string?>())
                                    .Where(n => n != null)
                                    .Distinct();

                                <tr data-id="@s.StudentId">
                                    <td>@s.FirstName</td>
                                    <td>@s.LastName</td>
                                    <td>
                                        @if (classNames != null && classNames.Any())
                                        {
                                            @(string.Join(", ", classNames))
                                        }
                                        else
                                        {
                                            <span class="text-muted">–</span>
                                        }
                                    </td>
                                    <td>
                                        @if (fieldNames != null && fieldNames.Any())
                                        {
                                            @(string.Join(", ", fieldNames))
                                        }
                                        else
                                        {
                                            <span class="text-muted">–</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-@(s.IsActive ? "success" : "secondary")">@(s.IsActive ? "Aktivní" : "Neaktivní")</span></td>
                                    @if (canCrudStudents)
                                    {
                                    <td class="text-center editButton"><a class="icon-btn student-edit-btn" title="Edit" data-id="@s.StudentId" role="button"><i class="bi bi-pencil-square"></i></a></td>
                                    <td class="text-center deleteButton d-none">
                                        <div class="btn-delete"><i class="bi bi-trash-fill"></i></div>
                                    </td>
                                    <td class="text-center deactivateButton d-none">
                                        <div class="btn-deactivate"><i class="bi bi-archive-fill"></i></div>
                                    </td>
                                    <td class="text-center activateButton d-none">
                                        <div class="btn-activate"><i class="bi bi-archive-fill"></i></div>
                                    </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <div>@Model.Students.Count položek</div>
                </div>
            </div>
        </div>

        <aside class="col-lg-3 order-1 order-lg-2">
            <div class="card shadow-sm sticky-top" style="top: 1rem;">
                <div class="card-header brandText fw-bold"><i class="bi bi-funnel me-2"></i>Filtrace</div>
                <div class="card-body">
                    <form method="get" class="vstack gap-2">
                        <input class="form-control" name="name" value="@Model.Name" placeholder="Jméno nebo příjmení" />

                        <select class="form-select select2" name="classId">
                            <option value="">Vyber třídu</option>
                            @foreach (var c in Model.Classes)
                            {
                                <option value="@c.ClassesId" selected="@(Model.ClassId == c.ClassesId)">@c.Name</option>
                            }
                        </select>

                        <select class="form-select select2" name="fieldId">
                            <option value="">Vyber obor</option>
                            @foreach (var f in Model.Fields)
                            {
                                <option value="@f.StudentFieldId" selected="@(Model.FieldId == f.StudentFieldId)">@f.Name</option>
                            }
                        </select>

                        <select class="form-select select2" name="active">
                            <option value="">Aktivní/Neaktivní</option>
                            <option value="true" selected="@(Model.Active == true)">Aktivní</option>
                            <option value="false" selected="@(Model.Active == false)">Neaktivní</option>
                        </select>

                        <button class="btn btn-orange w-100">
                            <i class="bi bi-funnel-fill me-2"></i>Filtrovat
                        </button>
                        <a href="@Url.Action("Index", "Students")" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-2"></i>Resetovat
                        </a>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-clipboard-data me-2"></i>Rychlé statistiky
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Celkem:</span>
                        <strong>@Model.Students.Count</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Aktivní:</span>
                        <strong class="text-success">@Model.Students.Count(x => x.IsActive)</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Neaktivní:</span>
                        <strong class="text-secondary">@Model.Students.Count(x => !x.IsActive)</strong>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

<input type="hidden" id="Ids" name="Ids" value="" />

<!-- Bulk Create Modal -->
<div class="modal fade" id="bulkModal" tabindex="-1" aria-labelledby="bulkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkModalLabel">
                    <i class="bi bi-people-fill me-2"></i>Hromadné vytvoření studentů
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Přiřadit do tříd (volitelné)</label>
                    <select class="form-select select2-bulk" id="bulkClassIds" multiple>
                        @foreach (var c in Model.Classes)
                        {
                            <option value="@c.ClassesId">@c.Name</option>
                        }
                    </select>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <label class="form-label fw-bold mb-0">Studenti</label>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="bulkAddRow">
                        <i class="bi bi-plus-circle me-1"></i>Přidat řádek
                    </button>
                </div>
                <div id="bulkRows">
                    <div class="row g-2 mb-2 bulk-row">
                        <div class="col-5">
                            <input type="text" class="form-control bulk-first" placeholder="Jméno" maxlength="64" />
                        </div>
                        <div class="col-5">
                            <input type="text" class="form-control bulk-last" placeholder="Příjmení" maxlength="64" />
                        </div>
                        <div class="col-2 d-flex align-items-center">
                            <button type="button" class="btn btn-sm btn-outline-danger bulk-remove-row" title="Odebrat">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="mt-2">
                    <hr />
                    <label class="form-label fw-bold">Nebo vložte ze schránky</label>
                    <textarea class="form-control" id="bulkPaste" rows="3"
                              placeholder="Jméno Příjmení (každý student na nový řádek)"></textarea>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="bulkParseBtn">
                        <i class="bi bi-clipboard me-1"></i>Zpracovat text
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zrušit</button>
                <button type="button" class="btn btn-orange" id="bulkSubmitBtn">
                    <i class="bi bi-check2-circle me-1"></i>Vytvořit studenty
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Editace studenta
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="editFormBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-orange" role="status"></div>
                        <p class="text-muted mt-2">Načítám formulář…</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zrušit</button>
                <button type="button" class="btn btn-orange" id="editSubmitBtn">
                    <i class="bi bi-check2-circle me-1"></i>Uložit změny
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/pages/Student.js" asp-append-version="true"></script>