@using SPSUL.Controllers
@{
    ViewData["Title"] = "Testy";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";
}
<link rel="stylesheet" href="~/css/normalTables.css" asp-append-version="true"/>

<div class="container-fluid py-3">
    <div class="row g-3">
        <div class="col-lg-9 order-2 order-lg-1">
            <div class="card shadow-sm cardTable">
                <div class="card-header brandText d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-journal-text me-2"></i>
                        Seznam testů
                    </h5>
                    <div class="tools d-flex justify-content-center align-items-center gap-2">
                        <!--Export-->
                        <a class="iconLink cursor" title="Exportovat statistiky" id="exportBtn">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                            Export
                        </a>
                        <!--Statistiky-->
                        <a class="iconLink cursor" title="Zobrazit statistiky" id="statsBtn">
                            <i class="bi bi-graph-up-arrow"></i>
                            Statistiky
                        </a>
                        <!--Activate-->
                        <a class="iconLink cursor mode" title="Aktivovat testy" id="activate" data-endpoint="Test/Activate/">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                            Aktivace
                        </a>
                        <!--Deactivate-->
                        <a class="iconLink cursor mode" title="Deaktivovat testy" id="deactivateMode" data-endpoint="Test/Deactivate/">
                            <i class="bi bi-arrow-down-circle-fill"></i>
                            Deaktivace
                        </a>
                        <!--Delete Mode-->
                        <a class="iconLink cursor mode" title="Smazat testy" id="deleteMode" data-endpoint="Test/Delete/">
                            <i class="bi bi-dash-circle"></i>
                            Smazat
                        </a>
                        <!--Create-->
                        <a class="iconLink mode" asp-action="Create" asp-controller="Test" title="Vytvořit test">
                            <i class="bi bi-plus-circle"></i>
                            Vytvořit
                        </a>
                    </div>
                </div>
                <div class="table-responsive tableContent">
                    <table class="table align-middle mb-0" style="min-width: 1200px">
                        <thead>
                            <tr>
                                <th class="col-1">ID</th>
                                <th class="col-3">Název</th>
                                <th class="col-2">Tvůrce</th>
                                <th class="col-2">Předmět</th>
                                <th class="col-1">Počet otázek</th>
                                <th class="col-1">Přiřazení</th>
                                <th class="col-1">Úspěšnost</th>
                                <th class="col-1">Aktivní</th>
                                <th class="col-1 text-center" id="editHeader" style="display:table-cell">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Sem přijdou data z controlleru - loop přes Model *@
                            @* Příklad: *@
                            @* @foreach (var test in Model.Tests.Items) {
                                <tr data-id="@test.TestId">
                                    <td>@test.TestId</td>
                                    <td>@test.Name</td>
                                    <td>@test.CreatorName</td>
                                    <td>@test.FieldName</td>
                                    <td>@test.QuestionCount</td>
                                    <td>@test.AssignmentCount</td>
                                    <td>@test.AvgSuccess %</td>
                                    <td><span class="badge bg-@(test.IsActive ? "success" : "secondary")">@(test.IsActive ? "Aktivní" : "Neaktivní")</span></td>
                                    <td class="text-center editButton"><a class="icon-btn" title="Edit" href="/Test/Edit?id=@test.TestId"><i class="bi bi-pencil-square"></i></a></td>
                                </tr>
                            } *@
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <div>Strana @ViewBag.Page / @ViewBag.TotalPages (@ViewBag.Total položek)</div>
                    <div class="btn-group">
                        <a class="btn btn-outline-secondary @(ViewBag.Page == 1 ? "disabled" : null)" 
                           href="@Url.Action("Index", new { q = ViewBag.Query, active = ViewBag.Active, author = ViewBag.Author, page = ViewBag.Page - 1, pageSize = ViewBag.PageSize })">
                            Předchozí
                        </a>
                        <a class="btn btn-outline-secondary @(ViewBag.Page >= ViewBag.TotalPages ? "disabled" : null)" 
                           href="@Url.Action("Index", new { q = ViewBag.Query, active = ViewBag.Active, author = ViewBag.Author, page = ViewBag.Page + 1, pageSize = ViewBag.PageSize })">
                            Další
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <aside class="col-lg-3 order-1 order-lg-2">
            <div class="card shadow-sm sticky-top" style="top: 1rem;">
                <div class="card-header brandText fw-bold"><i class="bi bi-funnel me-2"></i>Filtrace</div>
                <div class="card-body">
                    <form method="get" class="vstack gap-2">
                        <!--Název-->
                        <input class="form-control" name="q" value="@ViewBag.Query" placeholder="Hledat název testu" />
                        
                        <!--Tvůrce-->
                        <select class="form-select select2" name="creatorId">
                            <option disabled selected>Vyber tvůrce</option>
                            @* @foreach (var teacher in Model.Teachers) {
                                <option value="@teacher.TeacherId">@teacher.FirstName @teacher.LastName</option>
                            } *@
                        </select>
                        
                        <!--Předmět-->
                        <select class="form-select select2" name="fieldId">
                            <option disabled selected>Vyber předmět</option>
                            @* @foreach (var field in Model.Fields) {
                                <option value="@field.StudentFieldId">@field.Name</option>
                            } *@
                        </select>
                        
                        <!--Aktivní-->
                        <select class="form-select select2" name="active">
                            <option value="">Aktivní/Neaktivní</option>
                            <option value="true" selected="@(ViewBag.Active == "true")">Aktivní</option>
                            <option value="false" selected="@(ViewBag.Active == "false")">Neaktivní</option>
                        </select>
                        
                        
                        <button class="btn btn-orange w-100">
                            <i class="bi bi-funnel-fill me-2"></i>
                            Filtrovat
                        </button>
                        
                        <a href="@Url.Action("Index", "Test")" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-2"></i>
                            Resetovat
                        </a>
                    </form>
                </div>
            </div>
            
            <!-- Rychlé statistiky -->
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-clipboard-data me-2"></i>
                    Rychlé statistiky
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Celkem testů:</span>
                        <strong>@* TODO: @Model.Tests.Total *@ 0</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Aktivní:</span>
                        <strong class="text-success">@* TODO: @Model.Tests.Items.Count(x => x.IsActive) *@ 0</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Neaktivní:</span>
                        <strong class="text-secondary">@* TODO: @Model.Tests.Items.Count(x => !x.IsActive) *@ 0</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Na stránce:</span>
                        <strong class="text-primary">@* TODO: @Model.Tests.Items.Count *@ 0</strong>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

<input type="hidden" id="Ids" name="Ids" value="" />

@section Scripts {
    <script>
        // Export funkcionalita
        document.getElementById('exportBtn')?.addEventListener('click', function() {
            toastr.info('Export statistik bude dostupný brzy');
        });
        
        // Statistiky modal
        document.getElementById('statsBtn')?.addEventListener('click', function() {
            toastr.info('Detailní statistiky budou dostupné brzy');
        });
    </script>
}