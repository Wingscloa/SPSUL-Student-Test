@using SPSUL.Models.Data
@model List<Test>
@{
    ViewData["Title"] = "Testy";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";
    var students = ViewBag.Students as List<Student> ?? new();
    var classes = ViewBag.Classes as List<Classes> ?? new();

    var canCrudTests = Context.HasAnyPermission(AppPermissions.CrudTests, AppPermissions.ManageTests, AppPermissions.All);
}
<link rel="stylesheet" href="~/css/normalTables.css" asp-append-version="true"/>

<div class="container-fluid py-3">
    <div class="row g-3">
        <div class="col-lg-9 order-2 order-lg-1">
            <div class="card shadow-sm cardTable">
                <div class="card-header brandText d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-journal-text me-2"></i>Seznam testů
                    </h5>
                    <div class="tools d-flex justify-content-center align-items-center gap-2">
                        <!--Cancel-->
                        <a class="iconLink cursor option" id="cancelOption" style="display: none">
                            <i class="bi bi-dash-circle"></i>
                            Zrušit
                        </a>
                        <!--Confirm-->
                        <a class="iconLink cursor option" id="acceptOption" style="display: none">
                            <i class="bi bi-plus-circle"></i>
                            Potvrdit
                        </a>
                        <a class="iconLink cursor mode" title="Exportovat do PDF" href="/api/pdf/tests">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Export PDF
                        </a>
                        @if (canCrudTests)
                        {
                        <a class="iconLink cursor mode" title="Smazat testy" id="deleteMode" data-endpoint="Test/Delete/" data-method="POST">
                            <i class="bi bi-dash-circle"></i>
                            Smazat
                        </a>
                        <a class="iconLink mode" asp-action="Create" asp-controller="Test" title="Vytvořit test">
                            <i class="bi bi-plus-circle"></i>
                            Vytvořit
                        </a>
                        }
                    </div>
                </div>
                <div class="table-responsive tableContent">
                    <table class="table align-middle mb-0" style="min-width: 1000px">
                        <thead>
                            <tr>
                                <th>Nazev</th>
                                <th>Tvurce</th>
                                <th>Předmět</th>
                                <th>Otázek</th>
                                <th>Přiřazeno</th>
                                @if (canCrudTests)
                                {
                                <th class="text-center editHeader">Přiřadit</th>
                                <th class="text-center editHeader">Přiřazení</th>
                                <th class="text-center editHeader">Edit</th>
                                <th class="text-center editHeader">Stav</th>
                                <th class="col-1 d-none deleteHeader">Smazat</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                var snapshot = t.QuestionSnapshot ?? "[]";
                                int qCount = 0;
                                try { qCount = System.Text.Json.JsonSerializer.Deserialize<List<object>>(snapshot)?.Count ?? 0; } catch { }

                                <tr data-id="@t.TestId">
                                    <td><strong>@t.Name</strong></td>
                                    <td>@t.Creator?.FirstName @t.Creator?.LastName</td>
                                    <td><span class="badge bg-info">@t.StudentField?.Name</span></td>
                                    <td>@qCount</td>
                                    <td><span class="badge bg-secondary">@(t.StudentTests?.Count ?? 0)</span></td>
                                    @if (canCrudTests)
                                    {
                                    <td class="text-center editButton">
                                        @if (t.IsActive)
                                        {
                                            <button class="icon-btn btn-assign" title="Přiřadit studentům"
                                                    data-test-id="@t.TestId" data-test-name="@t.Name"
                                                    data-bs-toggle="modal" data-bs-target="#assignModal">
                                                <i class="bi bi-person-plus-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center editButton">
                                        @if ((t.StudentTests?.Count ?? 0) > 0)
                                        {
                                            <a class="icon-btn" title="Zobrazit přiřazení"
                                               href="/Test/Assignments?id=@t.TestId">
                                                <i class="bi bi-people-fill"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center editButton">
                                        <a class="icon-btn" title="Editovat" href="/Test/Edit?id=@t.TestId">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </td>
                                    <td class="text-center editButton">
                                        <button class="icon-btn btn-toggle-active" title="@(t.IsActive ? "Deaktivovat" : "Aktivovat")"
                                                data-test-id="@t.TestId" data-active="@t.IsActive.ToString().ToLower()">
                                            <i class="bi @(t.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-secondary")" style="font-size:1.3rem"></i>
                                        </button>
                                    </td>
                                    <td class="text-center deleteButton d-none">
                                        <div class="btn-delete"><i class="bi bi-trash-fill"></i></div>
                                    </td>
                                    }
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-5">
                                        <i class="bi bi-inbox" style="font-size: 3rem; color: #dee2e6;"></i>
                                        <p class="text-muted mt-3">Zatím žádné testy</p>
                                        @if (canCrudTests)
                                        {
                                        <a asp-action="Create" class="btn btn-orange">
                                            <i class="bi bi-plus-circle me-2"></i>Vytvořit první test
                                        </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <div>Celkem @Model.Count testů</div>
                </div>
            </div>
        </div>

        <aside class="col-lg-3 order-1 order-lg-2">
            <div class="card shadow-sm sticky-top" style="top: 1rem;">
                <div class="card-header brandText fw-bold">Filtrace</div>
                <div class="card-body">
                    <form method="get" class="vstack gap-2">
                        <input class="form-control" name="q" placeholder="Hledat název testu" />
                        <select class="form-select" name="active">
                            <option value="">Aktivní/Neaktivní</option>
                            <option value="true">Aktivní</option>
                            <option value="false">Neaktivní</option>
                        </select>
                        <button class="btn btn-orange w-100">
                            <i class="bi bi-funnel-fill me-2"></i>Filtrovat
                        </button>
                        <a href="@Url.Action("Index", "Test")" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-2"></i>Resetovat
                        </a>
                    </form>
                </div>
            </div>
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-clipboard-data me-2"></i>Rychlé statistiky
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Celkem testů:</span>
                        <strong>@Model.Count</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Aktivní:</span>
                        <strong class="text-success">@Model.Count(t => t.IsActive)</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Neaktivní:</span>
                        <strong class="text-secondary">@Model.Count(t => !t.IsActive)</strong>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

<!-- ASSIGN MODAL -->
<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #ff8a00, #ff6b00); color: white;">
                <h5 class="modal-title">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    Přiřadit test: <span id="assignTestName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="assignTestId" />

                <div class="row g-2 mb-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold mb-1">
                            <i class="bi bi-funnel me-1"></i>Filtrovat podle třídy
                        </label>
                        <select class="form-select" id="classFilter">
                            <option value="">Všechny třídy</option>
                            @foreach (var c in classes)
                            {
                                if(c != null)
                                {
                                    <option value="@c.ClassesId">@c.Name (@c.ClassesStudents.Count studentů)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold mb-1">
                            <i class="bi bi-search me-1"></i>Hledat
                        </label>
                        <input type="text" class="form-control" id="studentSearch" placeholder="Jméno studenta..." />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded" style="background:#f8f9fa;">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="selectAllStudents">
                        <label class="form-check-label fw-bold" for="selectAllStudents">Vybrat všechny dostupné</label>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="badge bg-orange" id="selectedStudentCount" style="background:#ff8a00;">0 vybráno</span>
                        <span class="badge bg-secondary" id="alreadyAssignedInfo"></span>
                    </div>
                </div>

                <div class="student-list" style="max-height: 400px; overflow-y: auto;">
                    @foreach (var s in students)
                    {
                        var classNames = string.Join(", ", s.ClassesStudents?.Select(cs => cs.Classes?.Name ?? "") ?? Array.Empty<string>());
                        var classIds = string.Join(",", s.ClassesStudents?.Select(cs => cs.ClassesId) ?? Array.Empty<int>());
                        var fullName = $"{s.FirstName} {s.LastName}";

                        <div class="student-item d-flex align-items-center p-2 rounded mb-1"
                             data-classes="@classIds" data-student-id="@s.StudentId" data-name="@fullName.ToLower()">
                            <input class="form-check-input student-checkbox me-2 flex-shrink-0" type="checkbox"
                                   value="@s.StudentId" id="student_@s.StudentId">
                            <label class="form-check-label w-100 d-flex align-items-center justify-content-between"
                                   for="student_@s.StudentId" style="cursor:pointer;">
                                <span>
                                    <strong>@s.FirstName @s.LastName</strong>
                                    @if (!string.IsNullOrEmpty(classNames))
                                    {
                                        <span class="badge bg-light text-dark border ms-2" style="font-weight:500;">@classNames</span>
                                    }
                                </span>
                                <span class="assign-status-badge"></span>
                            </label>
                        </div>
                    }
                </div>

                <div id="assignResults" class="mt-3" style="display: none;">
                    <div class="alert alert-success">
                        <h6 class="alert-heading"><i class="bi bi-check-circle me-2"></i>Test přiřazen!</h6>
                        <p class="mb-2">Přihlašovací kódy pro studenty:</p>
                        <div id="loginIdList"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" id="assignFooter">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zavřít</button>
                <button type="button" class="btn btn-orange" id="assignBtn">
                    <i class="bi bi-check-circle me-2"></i>Přiřadit vybraným
                </button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="Ids" name="Ids" value="" />

@section Scripts {
    <script>
        const assignmentMap = {};
        @foreach (var t in Model)
        {
                if (t.StudentTests != null && t.StudentTests.Any())
                {
                        var ids = string.Join(",", t.StudentTests.Select(st => st.StudentId));
                        <text>assignmentMap[@t.TestId] = [@ids];</text>
                }
        }
    </script>
    <script src="~/js/pages/TestIndex.js" asp-append-version="true"></script>
}
