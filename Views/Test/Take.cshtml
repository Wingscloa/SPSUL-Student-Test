@model SPSUL.Models.Display.TestModels.TakeTestViewModel
@{
    ViewData["Title"] = Model.TestName;
    Layout = null;
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.TestName - SPSUL Test</title>
    <link rel="shortcut icon" href="~/Image/ico.ico" />
    <link href="~/lib/bootstrap/customBootstrap.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/global.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/toastr.js/toastr.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/testTake.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/toastr.js/toastr.min.js"></script>
</head>
<body>
    <!-- HEADER -->
    <div class="test-header">
        <div>
            <h4>@Model.TestName</h4>
            <small>@Model.StudentName</small>
        </div>
        <div class="info">
            <span id="saveIndicator" style="opacity:0;transition:opacity .3s;font-size:.8rem;">
                <i class="bi bi-check-circle-fill" style="color:#4caf50"></i> Uloženo
            </span>
            <span><i class="bi bi-list-check me-1"></i><span id="answeredCount">0</span>/@Model.Questions.Count</span>
            <span id="timerWrap">
                <i class="bi bi-clock me-1"></i><span id="timer">00:00</span>
                @if (Model.TimeLimitMinutes.HasValue)
                {
                    <small style="opacity:.7;"> / @Model.TimeLimitMinutes min</small>
                }
            </span>
        </div>
    </div>

    <div class="test-layout">
        <!-- NAV -->
        <div class="question-nav">
            <h6><i class="bi bi-grid-3x3-gap me-2"></i>Otázky</h6>
            <div class="nav-grid">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    <button class="nav-btn @(i == Model.CurrentQuestionIndex ? "active" : "")" data-index="@i" onclick="goToQuestion(@i)">
                        @(i + 1)
                    </button>
                }
            </div>
            <hr />
            <button class="btn-orange w-100 mt-2" onclick="showFinishConfirm()">
                <i class="bi bi-check-circle me-2"></i>Odevzdat test
            </button>
        </div>

        <!-- QUESTIONS -->
        <div class="question-area">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var existing = Model.ExistingAnswers.FirstOrDefault(a => a.QuestionId == q.QuestionId);
                var letters = new[] { "A", "B", "C", "D", "E", "F", "G", "H" };

                <div class="question-card @(i == Model.CurrentQuestionIndex ? "active" : "")" data-index="@i" data-question-id="@q.QuestionId">
                    <div class="d-flex align-items-center mb-3">
                        <span class="question-number">@(i + 1)</span>
                        <span class="question-type-badge">@q.QuestionType</span>
                    </div>
                    <div class="question-header">@q.Header</div>
                    <div class="question-desc">@q.Description</div>

                    <div class="options-list">
                        @for (int j = 0; j < q.Options.Count; j++)
                        {
                            var opt = q.Options[j];
                            var isSelected = existing?.SelectedOptions?.Contains(opt.Text) == true;
                            var letter = j < letters.Length ? letters[j] : (j + 1).ToString();

                            <div class="option-item @(isSelected ? "selected" : "")"
                                 data-text="@opt.Text" onclick="selectOption(this, @i)">
                                <div class="option-marker">@letter</div>
                                <div class="option-text">@opt.Text</div>
                            </div>
                        }
                    </div>

                    <div class="question-footer">
                        @if (i > 0)
                        {
                            <button class="btn btn-outline-secondary" onclick="goToQuestion(@(i - 1))">
                                <i class="bi bi-arrow-left me-2"></i>Předchozí
                            </button>
                        }
                        else
                        {
                            <div></div>
                        }
                        @if (i < Model.Questions.Count - 1)
                        {
                            <button class="btn-orange" onclick="goToQuestion(@(i + 1))">
                                Další<i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn-orange" onclick="showFinishConfirm()">
                                <i class="bi bi-check-circle me-2"></i>Odevzdat test
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- FINISH CONFIRM -->
            <div class="finish-section" id="finishSection">
                <i class="bi bi-send-check" style="font-size: 4rem; color: #ff8a00;"></i>
                <h3 class="mt-3">Opravdu chcete odevzdat test?</h3>
                <p class="text-muted">
                    Zodpovězeno <strong><span id="finalAnswered">0</span></strong> z <strong>@Model.Questions.Count</strong> otázek.
                    <br>Po odevzdání nelze odpovědi změnit.
                </p>
                <div class="d-flex gap-3 justify-content-center mt-3">
                    <button class="btn btn-outline-secondary btn-lg" onclick="hideFinishConfirm()">
                        <i class="bi bi-arrow-left me-2"></i>Zpět k testu
                    </button>
                    <button class="btn-orange btn-lg" id="finishBtn" onclick="finishTest()">
                        <i class="bi bi-check-circle me-2"></i>Odevzdat
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- RESULT OVERLAY -->
    <div class="result-overlay" id="resultOverlay">
        <div class="result-card">
            <div id="resultIcon" style="font-size: 5rem;"></div>
            <div class="score" id="resultScore"></div>
            <h4 id="resultMessage" class="mt-2"></h4>
            <p class="text-muted" id="resultDetail"></p>
            <a href="/Auth/Test" class="btn-orange" style="display:inline-block; padding: .75rem 2rem; text-decoration: none; border-radius: 12px; margin-top: 1rem;">
                <i class="bi bi-house me-2"></i>Zpět na přihlášení
            </a>
        </div>
    </div>

    <script>
        // Razor-injected configuration (must be inline so Razor engine processes it)
        window.TEST_CONFIG = {
            loginId: '@Html.Raw(Model.LoginId)',
            totalQuestions: @Model.Questions.Count,
            elapsedAtLoad: Math.max(0, @((int)(DateTime.Now - Model.StartedAt).TotalSeconds)),
            timeLimitSec: @(Model.TimeLimitMinutes.HasValue ? Model.TimeLimitMinutes.Value * 60 : -1),
            savedQuestionIndex: @Model.CurrentQuestionIndex,
            existingAnswers: {}
        };
        @foreach (var ans in Model.ExistingAnswers)
        {
            <text>
            window.TEST_CONFIG.existingAnswers[@ans.QuestionId] = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ans.SelectedOptions));
            </text>
        }
    </script>
    <script src="~/js/pages/TestTake.js" asp-append-version="true"></script>
</body>
</html>
