@{
    ViewData["Title"] = "Ukázkový test";
    Layout = null;
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ukázkový test - SPSUL</title>
    <link rel="shortcut icon" href="~/Image/ico.ico" />
    <link href="~/lib/bootstrap/customBootstrap.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/global.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/toastr.js/toastr.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/toastr.js/toastr.min.js"></script>
</head>
<body>
    <!-- HEADER -->
    <div class="test-header">
        <div>
            <h4><i class="bi bi-lightning-charge-fill me-2"></i>Ukázkový test</h4>
            <small>Režim procvičování — bez přihlášení</small>
        </div>
        <div class="info">
            <span class="example-badge"><i class="bi bi-mortarboard me-1"></i>Příklad</span>
            <span><i class="bi bi-list-check me-1"></i><span id="answeredCount">0</span>/5</span>
        </div>
    </div>

    <div class="test-layout">
        <!-- NAV -->
        <div class="question-nav">
            <h6><i class="bi bi-grid-3x3-gap me-2"></i>Otázky</h6>
            <div class="nav-grid" id="navGrid"></div>
            <hr />
            <button class="btn-orange w-100 mt-2" id="evalNavBtn" onclick="showFinish()">
                <i class="bi bi-check-circle me-2"></i>Vyhodnotit test
            </button>
            <a href="/Auth/Test" class="btn btn-outline-secondary w-100 mt-2" style="font-size:.85rem;">
                <i class="bi bi-arrow-left me-2"></i>Zpět na přihlášení
            </a>
        </div>

        <!-- QUESTIONS -->
        <div class="question-area" id="questionArea"></div>
    </div>

    <!-- RESULT OVERLAY -->
    <div class="result-overlay" id="resultOverlay">
        <div class="result-card">
            <div id="resultIcon" style="font-size: 5rem;"></div>
            <div class="score" id="resultScore"></div>
            <h4 id="resultMessage" class="mt-2"></h4>
            <p class="text-muted" id="resultDetail"></p>
            <div class="d-flex gap-2 justify-content-center mt-3 flex-wrap">
                <button class="btn-orange" onclick="resetTest()" style="padding:.75rem 2rem; border-radius:12px;">
                    <i class="bi bi-arrow-clockwise me-2"></i>Zkusit znovu
                </button>
                <a href="/Auth/Test" class="btn btn-outline-secondary" style="padding:.75rem 2rem; border-radius:12px;">
                    <i class="bi bi-house me-2"></i>Zpět
                </a>
            </div>
        </div>
    </div>

    <script src="~/js/pages/TestExample.js" asp-append-version="true"></script>
</body>
</html>
