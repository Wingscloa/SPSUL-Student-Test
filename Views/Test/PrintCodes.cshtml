@using SPSUL.Models.Data
@{
    Layout = null;
    var test = ViewBag.Test as Test;
    var assignments = ViewBag.Assignments as List<StudentTest> ?? new();
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <title>Přihlašovací kódy - @test?.Name</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }

        h1 { text-align: center; margin-bottom: 5px; font-size: 1.4rem; }
        .subtitle { text-align: center; color: #666; margin-bottom: 20px; font-size: .9rem; }

        .toolbar {
            margin: 20px 0;
            text-align: center;
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .toolbar button, .toolbar a {
            padding: 10px 24px;
            font-size: 1rem;
            cursor: pointer;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-pdf { background: #d9534f; color: white; }
        .btn-pdf:hover { background: #c9302c; }
        .btn-pdf-selected { background: #5bc0de; color: white; }
        .btn-pdf-selected:hover { background: #31b0d5; }
        .btn-select-all { background: #5cb85c; color: white; }
        .btn-select-all:hover { background: #449d44; }
        .btn-back { background: transparent; color: #666; border: 1px solid #ccc; }

        .codes-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .code-card {
            border: 2px solid #333;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            page-break-inside: avoid;
            position: relative;
            cursor: pointer;
            transition: border-color .2s, box-shadow .2s;
        }
        .code-card.selected {
            border-color: #5bc0de;
            box-shadow: 0 0 0 3px rgba(91, 192, 222, 0.3);
        }
        .code-card .check-mark {
            position: absolute;
            top: 6px;
            left: 8px;
            width: 20px;
            height: 20px;
            border: 2px solid #ccc;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: transparent;
            transition: all .2s;
        }
        .code-card.selected .check-mark {
            background: #5bc0de;
            border-color: #5bc0de;
            color: white;
        }

        .code-card .student-name {
            font-weight: 700;
            font-size: .95rem;
            margin-bottom: 4px;
        }

        .code-card .test-name {
            font-size: .75rem;
            color: #666;
            margin-bottom: 8px;
        }

        .code-card .login-code {
            font-family: 'Courier New', monospace;
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 3px;
            padding: 8px;
            background: #f5f5f5;
            border-radius: 6px;
            margin-bottom: 6px;
        }

        .code-card .instructions {
            font-size: .65rem;
            color: #888;
        }

        @@media print {
            .toolbar { display: none !important; }
            body { padding: 10px; }
            .code-card { border-width: 1px; cursor: default; }
            .code-card .check-mark { display: none; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <a href="/Test/DownloadCodesPdf?id=@test?.TestId" class="btn-pdf">📄 Stáhnout vše (PDF)</a>
        <button onclick="downloadSelected()" class="btn-pdf-selected">📄 Stáhnout vybrané (PDF)</button>
        <button onclick="toggleAll()" class="btn-select-all">☑ Vybrat / Zrušit vše</button>
        <a href="/Test/Assignments?id=@test?.TestId" class="btn-back">← Zpět</a>
    </div>

    <h1>@test?.Name</h1>
    <p class="subtitle">Přihlašovací kódy pro studenty • Klikněte na kartu pro výběr</p>

    <div class="codes-grid">
        @foreach (var a in assignments)
        {
            <div class="code-card" data-login="@a.LoginId" onclick="toggleCard(this)">
                <div class="check-mark">✓</div>
                <div class="student-name">@a.Student.FirstName @a.Student.LastName</div>
                <div class="test-name">@test?.Name</div>
                <div class="login-code">@a.LoginId</div>
                <div class="instructions">Zadejte tento kód na přihlašovací stránce testu</div>
            </div>
        }
    </div>

    <script>
        function toggleCard(el) {
            el.classList.toggle('selected');
        }

        function toggleAll() {
            var cards = document.querySelectorAll('.code-card');
            var allSelected = Array.from(cards).every(c => c.classList.contains('selected'));
            cards.forEach(c => {
                if (allSelected) c.classList.remove('selected');
                else c.classList.add('selected');
            });
        }

        function downloadSelected() {
            var selected = document.querySelectorAll('.code-card.selected');
            if (selected.length === 0) {
                alert('Vyberte alespoň jeden kód.');
                return;
            }

            var loginIds = Array.from(selected).map(c => c.getAttribute('data-login'));

            fetch('/Test/DownloadSelectedCodesPdf', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ testId: @(test?.TestId ?? 0), loginIds: loginIds })
            })
            .then(resp => {
                if (!resp.ok) throw new Error('Chyba při generování PDF');
                return resp.blob();
            })
            .then(blob => {
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'Kody-vybrane.pdf';
                a.click();
                URL.revokeObjectURL(url);
            })
            .catch(err => alert(err.message));
        }
    </script>
</body>
</html>
