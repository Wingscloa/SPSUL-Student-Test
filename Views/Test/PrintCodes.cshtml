@using SPSUL.Models.Data
@{
    Layout = null;
    var test = ViewBag.Test as Test;
    var assignments = ViewBag.Assignments as List<StudentTest> ?? new();
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <title>Přihlašovací kódy - @test?.Name</title>
</head>
<body>
    <div class="toolbar">
        <a href="/Test/DownloadCodesPdf?id=@test?.TestId" class="btn-pdf">📄 Stáhnout vše (PDF)</a>
        <button onclick="downloadSelected()" class="btn-pdf-selected">📄 Stáhnout vybrané (PDF)</button>
        <button onclick="toggleAll()" class="btn-select-all">☑ Vybrat / Zrušit vše</button>
        <a href="/Test/Assignments?id=@test?.TestId" class="btn-back">← Zpět</a>
    </div>

    <h1>@test?.Name</h1>
    <p class="subtitle">Přihlašovací kódy pro studenty • Klikněte na kartu pro výběr</p>

    <div class="codes-grid">
        @foreach (var a in assignments)
        {
            <div class="code-card" data-login="@a.LoginId" onclick="toggleCard(this)">
                <div class="check-mark">✓</div>
                <div class="student-name">@a.Student.FirstName @a.Student.LastName</div>
                <div class="test-name">@test?.Name</div>
                <div class="login-code">@a.LoginId</div>
                <div class="instructions">Zadejte tento kód na přihlašovací stránce testu</div>
            </div>
        }
    </div>

    <script>
        function toggleCard(el) {
            el.classList.toggle('selected');
        }

        function toggleAll() {
            var cards = document.querySelectorAll('.code-card');
            var allSelected = Array.from(cards).every(c => c.classList.contains('selected'));
            cards.forEach(c => {
                if (allSelected) c.classList.remove('selected');
                else c.classList.add('selected');
            });
        }

        function downloadSelected() {
            var selected = document.querySelectorAll('.code-card.selected');
            if (selected.length === 0) {
                alert('Vyberte alespoň jeden kód.');
                return;
            }

            var loginIds = Array.from(selected).map(c => c.getAttribute('data-login'));

            fetch('/Test/DownloadSelectedCodesPdf', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ testId: @(test?.TestId ?? 0), loginIds: loginIds })
            })
            .then(resp => {
                if (!resp.ok) throw new Error('Chyba při generování PDF');
                return resp.blob();
            })
            .then(blob => {
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'Kody-vybrane.pdf';
                a.click();
                URL.revokeObjectURL(url);
            })
            .catch(err => alert(err.message));
        }
    </script>
</body>
</html>
