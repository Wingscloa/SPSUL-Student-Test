@using SPSUL.Models.Data
@{
    Layout = null;
    var test = ViewBag.Test as Test;
    var assignments = ViewBag.Assignments as List<StudentTest> ?? new();
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <title>Pøihlašovací kódy - @test?.Name</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }

        h1 { text-align: center; margin-bottom: 5px; font-size: 1.4rem; }
        .subtitle { text-align: center; color: #666; margin-bottom: 20px; font-size: .9rem; }

        .codes-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .code-card {
            border: 2px solid #333;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            page-break-inside: avoid;
        }

        .code-card .student-name {
            font-weight: 700;
            font-size: .95rem;
            margin-bottom: 4px;
        }

        .code-card .test-name {
            font-size: .75rem;
            color: #666;
            margin-bottom: 8px;
        }

        .code-card .login-code {
            font-family: 'Courier New', monospace;
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 3px;
            padding: 8px;
            background: #f5f5f5;
            border-radius: 6px;
            margin-bottom: 6px;
        }

        .code-card .instructions {
            font-size: .65rem;
            color: #888;
        }

        .no-print { margin: 20px 0; text-align: center; }

        @@media print {
            .no-print { display: none !important; }
            body { padding: 10px; }
            .code-card { border-width: 1px; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()" style="padding: 10px 30px; font-size: 1.1rem; cursor: pointer;
                background: #ff8a00; color: white; border: none; border-radius: 8px; font-weight: 600;">
            ??? Vytisknout kódy
        </button>
        <a href="/Test/Assignments?id=@test?.TestId" style="margin-left: 10px; color: #666;">? Zpìt</a>
    </div>

    <h1>@test?.Name</h1>
    <p class="subtitle">Pøihlašovací kódy pro studenty • Pøihlaste se na adrese školy</p>

    <div class="codes-grid">
        @foreach (var a in assignments)
        {
            <div class="code-card">
                <div class="student-name">@a.Student.FirstName @a.Student.LastName</div>
                <div class="test-name">@test?.Name</div>
                <div class="login-code">@a.LoginId</div>
                <div class="instructions">Zadejte tento kód na pøihlašovací stránce testu</div>
            </div>
        }
    </div>
</body>
</html>
