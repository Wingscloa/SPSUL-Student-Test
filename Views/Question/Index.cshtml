@using SPSUL.Models.Display
@using SPSUL.Models.Display.QuestionModels
@model QuestIndexVM
@{
    ViewData["Title"] = "Otázky";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";

    var canCrudQuestions = Context.HasAnyPermission(AppPermissions.ManageQuestions, AppPermissions.CrudTests, AppPermissions.All);
}

<link rel="stylesheet" href="~/css/normalTables.css" asp-append-version="true"/>

<div class="container-fluid py-3">
  <div class="row g-3">
    <div class="col-lg-9 order-2 order-lg-1">
            <div class="card shadow-sm cardTable">
                <div class="card-header brandText d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>
                        Seznam otázek
                    </h5>
                    <div class="tools d-flex justify-content-center align-items-center gap-2">
                        <!--Cancel-->
                        <a class="iconLink cursor option" id="cancelOption" style="display: none">
                            <i class="bi bi-dash-circle"></i>
                            Zrušit
                        </a>
                        <!--Confirm-->
                        <a class="iconLink cursor option" id="acceptOption" style="display: none">
                            <i class="bi bi-plus-circle"></i>
                            Potvrdit
                        </a>
                        @if (canCrudQuestions)
                        {
                        <!--Export-->
                        <a class="iconLink cursor mode" title="Exportovat do PDF" id="exportBtn">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Export PDF
                        </a>
                        <!--Delete Mode-->
                        <a class="iconLink cursor mode" title="Smazat otázky" id="deleteMode" data-endpoint="Question/Delete/" data-method="POST">
                            <i class="bi bi-dash-circle"></i>
                            Smazat
                        </a>
                        <!--Create-->
                        <a class="iconLink mode" asp-action="Create" asp-controller="Question" title="Vytvořit otázky">
                            <i class="bi bi-plus-circle"></i>
                            Vytvořit
                        </a>
                        }
                    </div>
        </div>
        <div class="table-responsive tableContent">
          <table class="table align-middle mb-0" style="min-width: 1200px">
            <thead>
              <tr>
                <th class="col-2">Název</th>
                <th class="col-4">Popis</th>
                <th class="col-2">Tvůrce</th>
                <th class="col-1">Počet odpovědí</th>
                <th class="col-2">Typ otázky</th>
                <th class="col-2">Typ předmětu</th>
                @if (canCrudQuestions)
                {
                <th class="col-1 text-center editHeader">Edit</th>
                <th class="col-1 text-center editHeader">Stav</th>
                <th class="col-1 d-none deleteHeader">Smazat</th>
                }
              </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Questions.Items)
            {
              <tr data-id="@r.QuestionId">
                <td>@r.Header</td>
                <td>
                    <div class="myTruncate">@r.Description</div>
                </td>
                <td>@r.CreatorName</td>
                <td>@r.OptionCount</td>
                <td>@r.QuestionTypeName</td>
                <td>@r.FieldName</td>
                @if (canCrudQuestions)
                {
                <td class="text-center editButton"><a class="icon-btn" title="Edit" href="/Question/Edit?id=@r.QuestionId"><i class="bi bi-pencil-square"></i></a></td>
                <td class="text-center editButton">
                    <button class="icon-btn btn-toggle-active" title="@(r.IsActive ? "Deaktivovat" : "Aktivovat")"
                            data-id="@r.QuestionId" data-active="@r.IsActive.ToString().ToLower()">
                        <i class="bi @(r.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-secondary")" style="font-size:1.3rem"></i>
                    </button>
                </td>
                <!-- Delete Button --> 
                <td class="text-center deleteButton d-none">
                    <div class="btn-delete">
                        <i class="bi bi-trash-fill"></i>
                    </div>
                </td>
                }
              </tr>
            }
            </tbody>
          </table>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
          <div>Strana @Model.Questions.PageIndex / @Model.Questions.TotalPages (@Model.Questions.TotalItems)</div>
          <div class="btn-group">
                        <a class="btn btn-outline-secondary @(Model.Questions.PageIndex == 1 ? "disabled" : null)" asp-route-pageNumber="@(Model.Questions.PageIndex - 1)">Předchozí</a>
                        <a class="btn btn-outline-secondary @(Model.Questions.PageIndex >= @Model.Questions.TotalPages ? "disabled" : null)" asp-route-pageNumber="@(Model.Questions.PageIndex + 1)">Další</a>
          </div>
        </div>
      </div>
    </div>
    <aside class="col-lg-3 order-1 order-lg-2">
      <div class="card shadow-sm sticky-top" style="top: 1rem;">
        <div class="card-header brandText fw-bold">
                    <i class="bi bi-funnel me-2"></i>Filtrace</div>
        <div class="card-body">
          <form method="get" class="vstack gap-2">
              <!--Nazev-->
                        <input class="form-control" name="Name" placeholder="Hledat název" value="@(string.IsNullOrEmpty(Model.Name) ? "" : Model.Name)" />
            <!--Tvurce-->
            <select class="form-select select2" name="CreatorId">
                <option disabled selected>Vyber tvůrce</option>
                @foreach (var t in Model.Teachers)
                    {
                        if(Model.CreatorId.HasValue && Model.CreatorId.Value == t.TeacherId)
                        {
                        <option value="@t.TeacherId" selected>
                            @foreach(var ti in t.Titles)
                                {
                                    @(ti.Title.Shortcut + " ")
                                }
                                        @t.FirstName @t.LastName
                        </option>                
                        }
                        else
                        {
                        <option value="@t.TeacherId">
                            @foreach (var ti in t.Titles)
                            {
                                @(ti.Title.Shortcut + " ")
                            }
                            @t.FirstName @t.LastName
                        </option>
                        }
                    }
            </select>
            <!-- Typ Otazky -->
            <select class="form-select select2" name="QuestionTypeId">
                <option disabled selected>Vyber typ otázky</option>
                @foreach (var t in Model.QuestionTypes)
                {
                    if(Model.QuestionTypeId.HasValue && Model.QuestionTypeId.Value == t.QuestionTypeId)
                    {
                        <option value="@t.QuestionTypeId" selected>@t.Name</option>
                    }
                    else
                    {
                        <option value="@t.QuestionTypeId">@t.Name</option>
                    }
                }
            </select>
            <!-- Typ Predmetu -->
            <select class="form-select select2" name="FieldId">
                <option disabled selected>Vyber typ předmětu</option>
                @foreach (var t in Model.Fields)
                {
                    if(Model.FieldId.HasValue && Model.FieldId.Value == t.StudentFieldId)
                    {
                        <option value="@t.StudentFieldId" selected>@t.Name</option>
                    }
                    else
                    {
                        <option value="@t.StudentFieldId">@t.Name</option>
                    }
                }
            </select>
            <!--Aktivni-->
            <select class="form-select select2" name="IsActive">
            @{
                var isActiveValues = new List<string?> { "Aktivní/Neaktivní", "Aktivní", "Neaktivní" };
                foreach(var val in isActiveValues)
                {
                    if (val == "Aktivní/Neaktivní")
                    {
                        <option disabled selected>@val</option>
                    }
                    else
                    {
                        if(Model.IsActive.HasValue && Model.IsActive.Value.ToString() == (val == "Aktivní" ? "True" : "False"))
                        {
                            <option value="@(val == "Aktivní" ? "true" : "false")" selected>@val</option>
                        }
                        else
                        {
                            <option value="@(val == "Aktivní" ? "true" : "false")">@val</option>
                        }
                    }
                }
            }
            </select>
            <button class="btn btn-orange w-100">
                <i class="bi bi-funnel-fill me-2"></i>
                Filtrovat
            </button>
            <a href="@Url.Action("Index", "Question")" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle me-2"></i>
                Resetovat
            </a>
          </form>
        </div>
      </div>
      
      <!-- Rychlé statistiky -->
      <div class="card shadow-sm mt-3">
        <div class="card-header bg-light fw-bold">
            <i class="bi bi-clipboard-data me-2"></i>
            Rychlé statistiky
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Celkem otázek:</span>
                <strong>@Model.Questions.TotalItems</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Aktivní:</span>
                <strong class="text-success">@Model.Questions.Items.Count(x => x.IsActive)</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Neaktivní:</span>
                <strong class="text-secondary">@Model.Questions.Items.Count(x => !x.IsActive)</strong>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Na stránce:</span>
                <strong class="text-primary">@Model.Questions.Items.Count</strong>
            </div>
        </div>
      </div>
    </aside>
  </div>
</div>
<input type="hidden" id="Ids" name="Ids" value="" />

@section Scripts {
    <script>
        // Export PDF
        document.getElementById('exportBtn')?.addEventListener('click', function() {
            var form = document.querySelector('aside form');
            var fd = new FormData(form);
            var body = {};
            var name = fd.get('Name');
            if (name) body.SearchFilter = name;
            var active = fd.get('IsActive');
            if (active === 'true') body.ActiveFilter = true;
            else if (active === 'false') body.ActiveFilter = false;
            var creatorId = fd.get('CreatorId');
            if (creatorId) body.CreatorId = parseInt(creatorId);
            var questionTypeId = fd.get('QuestionTypeId');
            if (questionTypeId) body.QuestionTypeId = parseInt(questionTypeId);
            var fieldId = fd.get('FieldId');
            if (fieldId) body.FieldId = parseInt(fieldId);

            fetch('/api/pdf/questions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            })
            .then(function(resp) {
                if (!resp.ok) throw new Error('Chyba pri generovani PDF');
                return resp.blob();
            })
            .then(function(blob) {
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'Otazky.pdf';
                a.click();
                URL.revokeObjectURL(url);
                toastr.success('PDF export dokoncen.');
            })
            .catch(function(err) { toastr.error(err.message); });
        });

        // Toggle Active
        document.querySelectorAll('.btn-toggle-active').forEach(btn => {
            btn.addEventListener('click', async function () {
                const id = parseInt(this.dataset.id);
                const icon = this.querySelector('i');

                try {
                    const res = await fetch('/Question/ToggleActive', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(id)
                    });
                    const data = await res.json();

                    if (res.ok) {
                        toastr.success(data.message);

                        if (data.isActive) {
                            icon.className = 'bi bi-toggle-on text-success';
                            this.title = 'Deaktivovat';
                        } else {
                            icon.className = 'bi bi-toggle-off text-secondary';
                            this.title = 'Aktivovat';
                        }
                    } else {
                        toastr.error(data.message || 'Chyba.');
                    }
                } catch {
                    toastr.error('Chyba při komunikaci se serverem.');
                }
            });
        });
    </script>
}
