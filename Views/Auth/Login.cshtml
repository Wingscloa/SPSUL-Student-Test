@{
    ViewData["Title"] = "Login učitele";
    Layout = "~/Views/Shared/Layouts/_Auth.cshtml";
}


<div class="auth-card">
    <div class="auth-logo-area">
        <img class="auth-logo" alt="SPSUL logo" src="/Image/logo/SPSUL.webp" />
        <h1 class="auth-brand">SPSUL</h1>
        <p class="auth-subtitle">Informační systém</p>
    </div>

    @if (TempData["TestError"] != null)
    {
        <div class="auth-alert auth-alert-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["TestError"]</span>
        </div>
    }

    <form asp-controller="Auth" asp-action="Login" id="loginForm" novalidate>
        <div class="auth-field">
            <label class="auth-label" for="NickName">
                <i class="bi bi-person"></i> Přezdívka
            </label>
            <div class="auth-input-wrap">
                <i class="bi bi-person-fill auth-input-icon"></i>
                <input type="text" id="NickName" name="NickName" class="auth-input"
                       placeholder="Zadejte přezdívku" required autocomplete="off" />
            </div>
            <div class="auth-field-feedback" id="nickFeedback"></div>
        </div>

        <div class="auth-field">
            <label class="auth-label" for="Password">
                <i class="bi bi-lock"></i> Heslo
            </label>
            <div class="auth-input-wrap">
                <i class="bi bi-lock-fill auth-input-icon"></i>
                <input type="password" id="Password" name="Password" class="auth-input"
                       placeholder="Zadejte heslo" required autocomplete="off" />
                <button type="button" class="auth-toggle-pw" tabindex="-1" aria-label="Zobrazit heslo">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <div class="auth-field-feedback" id="pwFeedback"></div>
        </div>

        <button type="submit" class="auth-submit" id="loginBtn">
            <span class="auth-submit-text">Přihlásit se</span>
            <i class="bi bi-arrow-right-circle-fill"></i>
        </button>
    </form>

    <div class="auth-footer">
        <a class="auth-link" asp-controller="Auth" asp-action="Test">
            <i class="bi bi-mortarboard me-1"></i>Jsem student
        </a>
    </div>
    <div class="auth-divider"></div>
</div>

<script src="~/js/pages/Login.js" asp-append-version="true"></script>
