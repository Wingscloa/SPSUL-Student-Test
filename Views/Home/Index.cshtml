@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";
}
<link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/home-dashboard.js"></script>
}

<div class="dashboard-container">
    
    <!-- HERO SECTION WITH WELCOME -->
    <section class="hero-welcome">
        <div class="welcome-content">
            <h1 class="welcome-title">
                <i class="bi bi-sun text-warning"></i> Dobrý den, <span class="text-orange">Učiteli</span>!
            </h1>
            <p class="welcome-subtitle text-muted">Přehled vaší výuky</p>
        </div>
        
        <!-- QUICK STATS CARDS -->
        <div class="quick-stats">
            <div class="stat-card stat-card--primary">
                <div class="stat-icon">
                    <i class="bi bi-clipboard-check"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value">24</div>
                    <div class="stat-label">Aktivních testů</div>
                </div>
            </div>
            
            <div class="stat-card stat-card--success">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value">156</div>
                    <div class="stat-label">Studentů</div>
                </div>
            </div>
            
            <div class="stat-card stat-card--info">
                <div class="stat-icon">
                    <i class="bi bi-graph-up"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value">78%</div>
                    <div class="stat-label">Průměrná úspěšnost</div>
                </div>
            </div>
            
            <div class="stat-card stat-card--warning">
                <div class="stat-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value">12</div>
                    <div class="stat-label">Čeká na opravu</div>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN DASHBOARD GRID -->
    <div class="dashboard-grid">
        
        <!-- LEFT COLUMN: Recent Activity -->
        <div class="dashboard-main">
            
            <!-- RECENT ACTIVITY CARD -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-activity text-orange me-2"></i>
                        Poslední aktivita
                    </h5>
                    <a href="/Detail/Index" class="btn btn-sm btn-outline-secondary">
                        Zobrazit vše
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="activity-list">
                        <div class="activity-item">
                            <div class="activity-icon bg-success-subtle">
                                <i class="bi bi-check-circle text-success"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">Test "Matematika - Funkce" byl dokončen</div>
                                <div class="activity-meta">
                                    <span class="activity-time">
                                        <i class="bi bi-clock me-1"></i>Před 5 minutami
                                    </span>
                                    <span class="activity-user">
                                        <i class="bi bi-person me-1"></i>3 studenti
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="activity-item">
                            <div class="activity-icon bg-primary-subtle">
                                <i class="bi bi-file-earmark-plus text-primary"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">Nová otázka přidána do banky</div>
                                <div class="activity-meta">
                                    <span class="activity-time">
                                        <i class="bi bi-clock me-1"></i>Před 1 hodinou
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="activity-item">
                            <div class="activity-icon bg-warning-subtle">
                                <i class="bi bi-exclamation-triangle text-warning"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">Test "Český jazyk" čeká na opravu</div>
                                <div class="activity-meta">
                                    <span class="activity-time">
                                        <i class="bi bi-clock me-1"></i>Před 3 hodinami
                                    </span>
                                    <span class="activity-user">
                                        <i class="bi bi-person me-1"></i>8 studentů
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="activity-item">
                            <div class="activity-icon bg-info-subtle">
                                <i class="bi bi-bar-chart text-info"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">Týdenní statistiky aktualizovány</div>
                                <div class="activity-meta">
                                    <span class="activity-time">
                                        <i class="bi bi-clock me-1"></i>Včera
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHARTS SECTION -->
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up text-orange me-2"></i>
                        Statistiky úspěšnosti
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="successRateChart" height="80"></canvas>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDEBAR: Quick Actions & Upcoming -->
        <aside class="dashboard-sidebar">
            
            <!-- QUICK ACTIONS -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-orange text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>
                        Rychlé akce
                    </h6>
                </div>
                <div class="card-body p-2">
                    <div class="d-grid gap-2">
                        <a href="/Test/Create" class="btn btn-outline-orange btn-sm">
                            <i class="bi bi-plus-circle me-2"></i>Vytvořit test
                        </a>
                        <a href="/Question/Create" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-patch-question me-2"></i>Přidat otázku
                        </a>
                        <a href="/Students/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-people me-2"></i>Správa studentů
                        </a>
                        <a href="/Detail/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-clipboard-data me-2"></i>Zobrazit výsledky
                        </a>
                    </div>
                </div>
            </div>

            <!-- UPCOMING TESTS -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0">
                        <i class="bi bi-calendar-event text-orange me-2"></i>
                        Nadcházející testy
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="upcoming-list">
                        <div class="upcoming-item">
                            <div class="upcoming-date">
                                <div class="date-day">15</div>
                                <div class="date-month">Led</div>
                            </div>
                            <div class="upcoming-content">
                                <div class="upcoming-title">Matematika - Derivace</div>
                                <div class="upcoming-meta">
                                    <small class="text-muted">
                                        <i class="bi bi-people me-1"></i>Třída 4.A • 28 studentů
                                    </small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="upcoming-item">
                            <div class="upcoming-date">
                                <div class="date-day">18</div>
                                <div class="date-month">Led</div>
                            </div>
                            <div class="upcoming-content">
                                <div class="upcoming-title">Český jazyk - Literatura</div>
                                <div class="upcoming-meta">
                                    <small class="text-muted">
                                        <i class="bi bi-people me-1"></i>Třída 3.B • 24 studentů
                                    </small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="upcoming-item">
                            <div class="upcoming-date">
                                <div class="date-day">22</div>
                                <div class="date-month">Led</div>
                            </div>
                            <div class="upcoming-content">
                                <div class="upcoming-title">Fyzika - Optika</div>
                                <div class="upcoming-meta">
                                    <small class="text-muted">
                                        <i class="bi bi-people me-1"></i>Třída 2.A • 30 studentů
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white text-center">
                    <a href="/Test/Index" class="text-muted small">
                        Zobrazit všechny testy <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- TIPS CARD -->
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <h6 class="text-primary">
                        <i class="bi bi-lightbulb me-2"></i>Tip dne
                    </h6>
                    <p class="small mb-0">
                        Zkuste využít obrázky v otázkách pro zvýšení zapojení studentů! 
                        Tests s vizuálním obsahem mají o 30% vyšší úspěšnost.
                    </p>
                </div>
            </div>
        </aside>
    </div>
</div>
