@{
    ViewData["Title"] = "Tvoř Testy";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";
}
<link rel="stylesheet" href="~/css/home.css" />

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
}

<div class="homeContainer">
    <div class="tests-grid">
        <section class="hero">
        </section>
        <section class="statsContainer">
            <div class="stats-grid">
                <div class="stats-item stats-item--xl bg-students" onclick="location.href='/Students/Index'">
                    <h1 class="gridHeader">Studenti</h1>
                </div>
                <div class="stats-item stats-item--wide bg-tests" onclick="location.href='/Question/Index'">
                    <h1 class="gridHeader">Seznam testů</h1>
                </div>
                <div class="stats-item bg-score" onclick="location.href='/Detail/Index'">
                    <h1 class="gridHeader">Výsledky testů</h1>
                </div>
                <div class="stats-item bg-questions" onclick="location.href='/Test/Create'">
                    <h1 class="gridHeader">Vytvořit test</h1>
                </div>
            </div>
        </section>
    </div>
</div>
