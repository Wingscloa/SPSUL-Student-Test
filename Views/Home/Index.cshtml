@using SPSUL.Models.Data
@using SPSUL.Models.Display
@model HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";

    var hour = DateTime.Now.Hour;
    string greeting;
    string greetIcon;
    if (hour < 12)
    {
        greeting = "Dobré ráno";
        greetIcon = "bi-sunrise text-warning";
    }
    else if (hour < 18)
    {
        greeting = "Dobrý den";
        greetIcon = "bi-sun text-warning";
    }
    else
    {
        greeting = "Dobrý večer";
        greetIcon = "bi-moon-stars text-info";
    }
}

<link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />

@section Scripts { 
    <script src="~/lib/Chart.js/chart.umd.js" asp-append-version="true"></script>
    <script>
        window.DASHBOARD_CONFIG = {
            monthlyLabels: @Html.Raw(Model.MonthlyLabels),
            monthlyValues: @Html.Raw(Model.MonthlyValues)
        };
    </script>
    <script src="~/js/pages/HomeDashboard.js" asp-append-version="true"></script>
}

<div class="dashboard-container">

    <!-- HERO SECTION -->
    <section class="hero-welcome">
        <div class="welcome-content">
            <h1 class="welcome-title">
                <i class="bi @greetIcon"></i> @greeting, <span class="text-orange">@Model.TeacherName</span>!
            </h1>
            <p class="welcome-subtitle text-muted">Přehled vaší výuky</p>
        </div>

        <div class="quick-stats">
            <div class="stat-card stat-card--primary">
                <div class="stat-icon"><i class="bi bi-clipboard-check"></i></div>
                <div class="stat-content">
                    <div class="stat-value" data-target="@Model.ActiveTests">0</div>
                    <div class="stat-label">Aktivních testů</div>
                </div>
            </div>
            <div class="stat-card stat-card--success">
                <div class="stat-icon"><i class="bi bi-people"></i></div>
                <div class="stat-content">
                    <div class="stat-value" data-target="@Model.TotalStudents">0</div>
                    <div class="stat-label">Studentů</div>
                </div>
            </div>
            <div class="stat-card stat-card--info">
                <div class="stat-icon"><i class="bi bi-graph-up"></i></div>
                <div class="stat-content">
                    <div class="stat-value" data-target="@Model.AvgSuccess.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" data-suffix="%">0%</div>
                    <div class="stat-label">Průměrná úspěšnost</div>
                </div>
            </div>
            <div class="stat-card stat-card--warning">
                <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                <div class="stat-content">
                    <div class="stat-value" data-target="@Model.PendingCount">0</div>
                    <div class="stat-label">Čeká na zahájení</div>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN DASHBOARD GRID -->
    <div class="dashboard-grid">

        <!-- LEFT COLUMN -->
        <div class="dashboard-main">

            <!-- RECENT ACTIVITY -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-activity text-orange me-2"></i>
                        Poslední aktivita
                    </h5>
                    <a href="/Detail/Index" class="btn btn-sm btn-outline-secondary">Zobrazit vše</a>
                </div>
                <div class="card-body p-0">
                    <div class="activity-list">
                        @if (Model.RecentFinished.Any())
                        {
                            @foreach (var st in Model.RecentFinished)
                            {
                                var ago = DateTime.UtcNow - st.FinishedAt;
                                string agoText;
                                if (ago.TotalMinutes < 1)
                                    agoText = "Prave ted";
                                else if (ago.TotalMinutes < 60)
                                    agoText = $"Pred {(int)ago.TotalMinutes} min";
                                else if (ago.TotalHours < 24)
                                    agoText = $"Pred {(int)ago.TotalHours} hod";
                                else if (ago.TotalDays < 30)
                                    agoText = $"Pred {(int)ago.TotalDays} dny";
                                else
                                    agoText = st.FinishedAt.ToString("d. M. yyyy");

                                <div class="activity-item">
                                    <div class="activity-icon bg-success-subtle">
                                        <i class="bi bi-check-circle text-success"></i>
                                    </div>
                                    <div class="activity-content">
                                        <div class="activity-title">
                                            @st.Student.FirstName @st.Student.LastName dokončil/a „@st.Test.Name"
                                        </div>
                                        <div class="activity-meta">
                                            <span class="activity-time">
                                                <i class="bi bi-clock me-1"></i>@agoText
                                            </span>
                                            <span class="activity-user">
                                                <i class="bi bi-key me-1"></i>@st.LoginId
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 opacity-25"></i>
                                <p class="mt-2 mb-0">Zatím žádná aktivita</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- CHART -->
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up text-orange me-2"></i>
                        Statistiky úspěšnosti
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="successRateChart" height="80"></canvas>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDEBAR -->
        <aside class="dashboard-sidebar">

            <!-- QUICK ACTIONS -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-orange text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>
                        Rychlé akce
                    </h6>
                </div>
                <div class="card-body p-2">
                    <div class="d-grid gap-2">
                        @if (Context.HasAnyPermission(AppPermissions.CrudTests, AppPermissions.ManageTests, AppPermissions.All))
                        {
                        <a href="/Test/Create" class="btn btn-outline-orange btn-sm">
                            <i class="bi bi-plus-circle me-2"></i>Vytvořit test
                        </a>
                        }
                        @if (Context.HasAnyPermission(AppPermissions.ManageQuestions, AppPermissions.CrudTests, AppPermissions.All))
                        {
                        <a href="/Question/Create" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-patch-question me-2"></i>Přidat otázku
                        </a>
                        }
                        <a href="/Students/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-people me-2"></i>Správa studentů
                        </a>
                        <a href="/Detail/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-clipboard-data me-2"></i>Zobrazit výsledky
                        </a>
                    </div>
                </div>
            </div>

            <!-- UPCOMING TESTS (active with pending students) -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0">
                        <i class="bi bi-calendar-event text-orange me-2"></i>
                        Testy čekající na studenty
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="upcoming-list">
                        @if (Model.UpcomingTests.Any())
                        {
                            @foreach (var t in Model.UpcomingTests)
                            {
                                var pending = t.StudentTests?.Count(st => st.StartedAt == DateTime.MinValue) ?? 0;

                                <div class="upcoming-item">
                                    <div class="upcoming-date">
                                        <div class="date-day">@pending</div>
                                        <div class="date-month">čeká</div>
                                    </div>
                                    <div class="upcoming-content">
                                        <div class="upcoming-title">@t.Name</div>
                                        <div class="upcoming-meta">
                                            <small class="text-muted">
                                                <i class="bi bi-book me-1"></i>@t.StudentField?.Name
                                                •
                                                <i class="bi bi-people ms-1 me-1"></i>@(t.StudentTests?.Count ?? 0) přiřazeno
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <p class="mb-0 small">Žádné čekající testy</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white text-center">
                    <a href="/Test/Index" class="text-muted small">
                        Zobrazit všechny testy <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- OVERVIEW CARD -->
            <div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #ff8a00, #ff6b00);">
                <div class="card-body text-white">
                    <h6><i class="bi bi-bar-chart me-2"></i>Přehled v číslech</h6>
                    <div class="d-flex justify-content-between mt-3 mb-1">
                        <small>Otázek v bance:</small>
                        <strong>@Model.TotalQuestions</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <small>Aktivních testů:</small>
                        <strong>@Model.ActiveTests</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <small>Dokončených testů:</small>
                        <strong>@Model.RecentFinished.Count</strong>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>
