@{
    ViewData["Title"] = "Statistiky";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";

    int totalTests = ViewBag.TotalTests;
    double overallAvg = ViewBag.OverallAvg;
    int passed = ViewBag.Passed;
    int failed = ViewBag.Failed;
    string testStatsJson = ViewBag.TestStatsJson;
    string classStatsJson = ViewBag.ClassStatsJson;
    string timeTrendJson = ViewBag.TimeTrendJson;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">
            <i class="bi bi-graph-up-arrow me-2" style="color: #ff8a00;"></i>
            Statistiky výsledkù
        </h4>
        <a href="/Detail/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Zpìt na výsledky
        </a>
    </div>

    <!-- Overview cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-top: 4px solid #0d6efd !important;">
                <div class="card-body text-center">
                    <i class="bi bi-clipboard-check fs-2 text-primary"></i>
                    <h2 class="mt-2 mb-0">@totalTests</h2>
                    <small class="text-muted">Dokonèených testù</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-top: 4px solid #ff8a00 !important;">
                <div class="card-body text-center">
                    <i class="bi bi-speedometer fs-2" style="color: #ff8a00;"></i>
                    <h2 class="mt-2 mb-0">@overallAvg.ToString("F1")%</h2>
                    <small class="text-muted">Prùmìrná úspìšnost</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-top: 4px solid #198754 !important;">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle fs-2 text-success"></i>
                    <h2 class="mt-2 mb-0">@passed</h2>
                    <small class="text-muted">Prospìlo</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm" style="border-top: 4px solid #dc3545 !important;">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle fs-2 text-danger"></i>
                    <h2 class="mt-2 mb-0">@failed</h2>
                    <small class="text-muted">Neprospìlo</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-bar-chart me-2"></i>Úspìšnost podle testù
                </div>
                <div class="card-body">
                    <canvas id="testChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-pie-chart me-2"></i>Prospìl / Neprospìl
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="pieChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-people me-2"></i>Úspìšnost podle tøíd
                </div>
                <div class="card-body">
                    <canvas id="classChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-graph-up me-2"></i>Trend (posledních 30 dní)
                </div>
                <div class="card-body">
                    <canvas id="trendChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
    const testStats = @Html.Raw(testStatsJson);
    const classStats = @Html.Raw(classStatsJson);
    const timeTrend = @Html.Raw(timeTrendJson);

    const orange = '#ff8a00';
    const orangeLight = 'rgba(255,138,0,.2)';

    // Test bar chart
    new Chart(document.getElementById('testChart'), {
        type: 'bar',
        data: {
            labels: testStats.map(t => t.Name.length > 25 ? t.Name.substring(0, 25) + '...' : t.Name),
            datasets: [{
                label: 'Prùmìr %',
                data: testStats.map(t => t.AvgPct.toFixed(1)),
                backgroundColor: testStats.map(t => t.AvgPct >= 80 ? '#198754' : t.AvgPct >= 50 ? '#ffc107' : '#dc3545'),
                borderRadius: 6,
                maxBarThickness: 60
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } } }
        }
    });

    // Pie chart
    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: {
            labels: ['Prospìl', 'Neprospìl'],
            datasets: [{
                data: [@passed, @failed],
                backgroundColor: ['#198754', '#dc3545'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } }
        }
    });

    // Class chart
    new Chart(document.getElementById('classChart'), {
        type: 'bar',
        data: {
            labels: classStats.map(c => c.ClassName),
            datasets: [{
                label: 'Prùmìr %',
                data: classStats.map(c => c.AvgPct.toFixed(1)),
                backgroundColor: orange,
                borderRadius: 6,
                maxBarThickness: 60
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } } }
        }
    });

    // Trend line chart
    new Chart(document.getElementById('trendChart'), {
        type: 'line',
        data: {
            labels: timeTrend.map(t => t.Date),
            datasets: [
                {
                    label: 'Prùmìr %',
                    data: timeTrend.map(t => t.AvgPct.toFixed(1)),
                    borderColor: orange,
                    backgroundColor: orangeLight,
                    fill: true,
                    tension: .4,
                    yAxisID: 'y'
                },
                {
                    label: 'Poèet testù',
                    data: timeTrend.map(t => t.Count),
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13,110,253,.1)',
                    fill: false,
                    tension: .4,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true, max: 100, position: 'left', ticks: { callback: v => v + '%' } },
                y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false } }
            }
        }
    });
</script>
}
