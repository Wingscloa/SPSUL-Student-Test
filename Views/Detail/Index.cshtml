@using System.Linq
@model SPSUL.Models.ViewModels.DetailIndexViewModel
@{
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";
    ViewData["Title"] = "Výsledky testů";
}

<link rel="stylesheet" href="~/css/normalTables.css" asp-append-version="true"/>

<div class="container-fluid py-3">
    <div class="row g-3">
        <div class="col-lg-9 order-2 order-lg-1">
            <div class="card shadow-sm cardTable">
                <div class="card-header brandText d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-clipboard-check me-2"></i>
                        Výsledky dokončených testů
                    </h5>
                    <div class="tools d-flex justify-content-center align-items-center gap-2">
                        <!--Export-->
                        <a class="iconLink cursor" title="Exportovat do Excel" id="exportBtn">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                            Export
                        </a>
                        <!--Statistiky-->
                        <a class="iconLink cursor" title="Zobrazit statistiky" id="statsBtn">
                            <i class="bi bi-graph-up-arrow"></i>
                            Statistiky
                        </a>
                    </div>
                </div>
                <div class="table-responsive tableContent">
                    <table class="table align-middle mb-0" style="min-width: 1400px">
                        <thead>
                            <tr>
                                <th class="col-1">ID</th>
                                <th class="col-2">Název testu</th>
                                <th class="col-2">Student</th>
                                <th class="col-1">Login ID</th>
                                <th class="col-1">Začal</th>
                                <th class="col-1">Dokončil</th>
                                <th class="col-1">Čas</th>
                                <th class="col-1">Úspěšnost</th>
                                <th class="col-1">Absolvoval</th>
                                <th class="col-1 text-center">Historie</th>
                                <th class="col-1 text-center">Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Assigned.Items)
                            {
                                var duration = t.DokoncilV - t.ZacalV;
                                var successClass = t.UspechPct >= 80 ? "success" : t.UspechPct >= 50 ? "warning" : "danger";
                                
                                <tr data-id="@t.Id">
                                    <td>@t.Id</td>
                                    <td>
                                        <strong>@t.Nazev</strong>
                                    </td>
                                    <td>@t.Jmeno</td>
                                    <td>
                                        <span class="badge bg-secondary">@t.LoginId</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@t.ZacalV.ToString("dd.MM.yyyy")</small><br>
                                        <small>@t.ZacalV.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@t.DokoncilV.ToString("dd.MM.yyyy")</small><br>
                                        <small>@t.DokoncilV.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">
                                            @duration.Minutes min @duration.Seconds s
                                        </span>
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar bg-@successClass" role="progressbar" 
                                                 style="width: @t.UspechPct%" 
                                                 aria-valuenow="@t.UspechPct" aria-valuemin="0" aria-valuemax="100">
                                                <strong>@t.UspechPct%</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (t.Absolvoval)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Ano
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill me-1"></i>
                                                Ne
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a class="icon-btn" title="Zobrazit historii odpovědí" 
                                           href="/Detail/History?id=@t.Id">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a class="icon-btn" title="Zobrazit detail testu" 
                                           href="/Detail/View?id=@t.Id">
                                            <i class="bi bi-file-text"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            
                            @if (!Model.Assigned.Items.Any())
                            {
                                <tr>
                                    <td colspan="11" class="text-center py-5">
                                        <i class="bi bi-inbox" style="font-size: 3rem; color: #dee2e6;"></i>
                                        <p class="text-muted mt-3">Zatím žádné dokončené testy</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Strana @Model.Assigned.Page / @Model.Assigned.TotalPages</strong>
                        <span class="text-muted">(@Model.Assigned.Total položek)</span>
                    </div>
                    <div class="btn-group">
                        <a class="btn btn-outline-secondary @(Model.Assigned.Page == 1 ? "disabled" : "")" 
                           href="@Url.Action("Index", new { Q1 = Model.Q1, Active1 = Model.Active1, Page1 = Model.Assigned.Page - 1, PageSize1 = Model.PageSize1 })">
                            <i class="bi bi-chevron-left me-1"></i>
                            Předchozí
                        </a>
                        <a class="btn btn-outline-secondary @(Model.Assigned.Page >= Model.Assigned.TotalPages ? "disabled" : "")" 
                           href="@Url.Action("Index", new { Q1 = Model.Q1, Active1 = Model.Active1, Page1 = Model.Assigned.Page + 1, PageSize1 = Model.PageSize1 })">
                            Další
                            <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <aside class="col-lg-3 order-1 order-lg-2">
            <div class="card shadow-sm sticky-top" style="top: 1rem;">
                <div class="card-header brandText fw-bold">
                    <i class="bi bi-funnel me-2"></i>Filtrace
                </div>
                <div class="card-body">
                    <form method="get" class="vstack gap-3">
                        <!--Název testu / Jméno studenta-->
                        <div>
                            <label class="form-label small fw-bold">Hledat</label>
                            <input class="form-control" name="Q1" value="@Model.Q1" 
                                   placeholder="Název testu nebo jméno studenta" />
                        </div>
                        
                        <!--Úspěšnost-->
                        <div>
                            <label class="form-label small fw-bold">Úspěšnost</label>
                            <select class="form-select select2" name="successRange">
                                <option value="">Všechny</option>
                                <option value="80-100">80% - 100% (Výborně)</option>
                                <option value="50-79">50% - 79% (Dobře)</option>
                                <option value="0-49">0% - 49% (Neprospěl)</option>
                            </select>
                        </div>
                        
                        <!--Absolvoval-->
                        <div>
                            <label class="form-label small fw-bold">Absolvoval</label>
                            <select class="form-select select2" name="completed">
                                <option value="">Vše</option>
                                <option value="true">Ano</option>
                                <option value="false">Ne</option>
                            </select>
                        </div>
                        
                        <!--Datum od-->
                        <div>
                            <label class="form-label small fw-bold">Datum od</label>
                            <input type="date" class="form-control" name="dateFrom" />
                        </div>
                        
                        <!--Datum do-->
                        <div>
                            <label class="form-label small fw-bold">Datum do</label>
                            <input type="date" class="form-control" name="dateTo" />
                        </div>
                        
                        <!--Řazení-->
                        <div>
                            <label class="form-label small fw-bold">Řadit podle</label>
                            <select class="form-select select2" name="sortBy">
                                <option value="date-desc">Nejnovější první</option>
                                <option value="date-asc">Nejstarší první</option>
                                <option value="success-desc">Úspěšnost (nejvyšší)</option>
                                <option value="success-asc">Úspěšnost (nejnižší)</option>
                                <option value="name-asc">Název (A-Z)</option>
                                <option value="name-desc">Název (Z-A)</option>
                            </select>
                        </div>
                        
                        <button class="btn btn-orange w-100">
                            <i class="bi bi-funnel-fill me-2"></i>
                            Filtrovat
                        </button>
                        
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-2"></i>
                            Resetovat
                        </a>
                    </form>
                </div>
            </div>
            
            <!-- Rychlé statistiky -->
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-clipboard-data me-2"></i>
                    Rychlé statistiky
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Celkem testů:</span>
                        <strong>@Model.Assigned.Total</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Absolvováno:</span>
                        <strong class="text-success">@Model.Assigned.Items.Count(x => x.Absolvoval)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Neprospěl:</span>
                        <strong class="text-danger">@Model.Assigned.Items.Count(x => !x.Absolvoval)</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Průměr:</span>
                        <strong class="text-primary">
                            @(Model.Assigned.Items.Any() ? Model.Assigned.Items.Average(x => x.UspechPct).ToString("F1") : "0")%
                        </strong>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        // Export funkcionalita
        document.getElementById('exportBtn')?.addEventListener('click', function() {
            toastr.info('Export do Excel bude dostupný brzy');
        });
        
        // Statistiky modal
        document.getElementById('statsBtn')?.addEventListener('click', function() {
            toastr.info('Detailní statistiky budou dostupné brzy');
        });
        
        // Initialize Select2
        $(document).ready(function() {
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });
        });
    </script>
}
