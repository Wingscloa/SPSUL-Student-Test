@using SPSUL.Models.Data
@using SPSUL.Models.Display.TestModels
@{
    ViewData["Title"] = "Detail testu";
    Layout = "~/Views/Shared/Layouts/_Main.cshtml";

    var assignment = ViewBag.Assignment as StudentTest;
    var questions = ViewBag.Questions as List<QuestionSnapshotItem> ?? new();
    var answers = ViewBag.Answers as List<AnswerSnapshot> ?? new();

    int correct = 0;
    foreach (var q in questions)
    {
        var ans = answers.FirstOrDefault(a => a.QuestionId == q.QuestionId);
        if (ans != null)
        {
            var cOpts = q.Options.Where(o => o.IsCorrect).Select(o => o.Text).OrderBy(t => t).ToList();
            var sOpts = ans.SelectedOptions.OrderBy(t => t).ToList();
            if (cOpts.SequenceEqual(sOpts)) correct++;
        }
    }
    int total = questions.Count;
    int pct = total > 0 ? (int)Math.Round((double)correct / total * 100) : 0;
    var pctClass = pct >= 80 ? "success" : pct >= 50 ? "warning" : "danger";
    var duration = assignment != null ? assignment.FinishedAt - assignment.StartedAt : TimeSpan.Zero;
}

<link rel="stylesheet" href="~/css/normalTables.css" asp-append-version="true" />

<style>
    @@media print {
        body, html { background: white !important; }
        .navbar, .sidebar, .tabbar, .card-header .d-flex.gap-2, footer { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
        .card-header { background: white !important; color: black !important; border-bottom: 2px solid #ff8a00 !important; }
        .card-header h5 { color: black !important; }
        .container-fluid { padding: 0 !important; }
        .print-header { display: flex !important; }
        .progress { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .badge, .progress-bar, .border-start { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .bg-success, .bg-danger, .bg-warning, .bg-secondary, .bg-info { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .bg-success.bg-opacity-10, .bg-danger.bg-opacity-10 { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .question-block { break-inside: avoid; }
    }
    .print-header { display: none; }
</style>

<div class="container-fluid py-3">
    <!-- Print-only header -->
    <div class="print-header mb-4 align-items-center justify-content-between" style="display:none;">
        <div>
            <h4 class="mb-0">Detail testu</h4>
            <small class="text-muted">Vytisteno: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</small>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header brandText d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-file-text me-2"></i>
                Detail dokonceneho testu
            </h5>
            <div class="d-flex gap-2">
                <button class="btn btn-light btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Tisk
                </button>
                <a href="/Detail/Index" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Zpet
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (assignment != null)
            {
                <!-- Info cards -->
                <div class="row mb-4 pb-4 border-bottom g-3">
                    <div class="col-md-3 col-6">
                        <div class="d-flex align-items-center p-3 rounded h-100" style="background: #f8f9fa; border: 1px solid #dee2e6;">
                            <i class="bi bi-journal-text fs-3 me-3" style="color: #ff8a00;"></i>
                            <div>
                                <small class="text-muted">Test</small>
                                <div class="fw-bold">@assignment.Test.Name</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="d-flex align-items-center p-3 rounded h-100" style="background: #f8f9fa; border: 1px solid #dee2e6;">
                            <i class="bi bi-person-circle fs-3 text-primary me-3"></i>
                            <div>
                                <small class="text-muted">Student</small>
                                <div class="fw-bold">@assignment.Student.FirstName @assignment.Student.LastName</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="d-flex align-items-center p-3 rounded h-100" style="background: #f8f9fa; border: 1px solid #dee2e6;">
                            <i class="bi bi-clock fs-3 text-info me-3"></i>
                            <div>
                                <small class="text-muted">Cas</small>
                                <div class="fw-bold">@((int)duration.TotalMinutes) min @duration.Seconds s</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="d-flex align-items-center p-3 rounded h-100" style="background: #f8f9fa; border: 1px solid #dee2e6;">
                            <i class="bi bi-calendar-check fs-3 text-secondary me-3"></i>
                            <div>
                                <small class="text-muted">Zacal / Dokoncil</small>
                                <div class="fw-bold" style="font-size:.8rem;">@assignment.StartedAt.ToString("dd.MM.yyyy HH:mm")</div>
                                <div class="fw-bold" style="font-size:.8rem;">@assignment.FinishedAt.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="d-flex align-items-center p-3 rounded h-100" style="background: #f8f9fa; border: 1px solid #dee2e6;">
                            <i class="bi bi-trophy fs-3 text-@pctClass me-3"></i>
                            <div>
                                <small class="text-muted">Uspesnost</small>
                                <div class="fw-bold text-@pctClass">@pct% (@correct/@total)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Progress bar -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="progress flex-grow-1" style="height: 30px; border-radius: 15px;">
                            <div class="progress-bar bg-@pctClass" role="progressbar"
                                 style="width: @pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                        <strong class="text-@pctClass fs-5" style="min-width:50px; text-align:right;">@pct%</strong>
                    </div>
                </div>

                <!-- Login info -->
                <div class="mb-4 p-2 rounded" style="background:#f8f9fa;">
                    <small class="text-muted"><i class="bi bi-key me-1"></i>Login ID: <strong>@assignment.LoginId</strong></small>
                </div>

                <!-- Otazky s historii -->
                <h5 class="mb-3">
                    <i class="bi bi-list-ol me-2"></i>Odpovedi na otazky
                </h5>

                @for (int i = 0; i < questions.Count; i++)
                {
                    var q = questions[i];
                    var answer = answers.FirstOrDefault(a => a.QuestionId == q.QuestionId);
                    var correctOpts = q.Options.Where(o => o.IsCorrect).Select(o => o.Text).OrderBy(t => t).ToList();
                    var selectedOpts = answer?.SelectedOptions?.OrderBy(t => t).ToList() ?? new List<string>();
                    var isCorrect = correctOpts.SequenceEqual(selectedOpts);

                    <div class="question-block mb-3 p-3 rounded border-start border-4 border-@(isCorrect ? "success" : "danger")"
                         style="background: #f8f9fa;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="mb-0">
                                <span class="badge bg-secondary me-2">@(i + 1)</span>
                                @q.Header
                            </h6>
                            <span class="badge bg-@(isCorrect ? "success" : "danger")">
                                @(isCorrect ? "Spravne" : "Spatne")
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(q.Description))
                        {
                            <p class="text-muted small mb-3">@q.Description</p>
                        }

                        @foreach (var opt in q.Options)
                        {
                            var wasSelected = selectedOpts.Contains(opt.Text);
                            var isCorrectOpt = opt.IsCorrect;
                            var cls = "";
                            if (wasSelected && isCorrectOpt) cls = "border-success bg-success bg-opacity-10";
                            else if (wasSelected && !isCorrectOpt) cls = "border-danger bg-danger bg-opacity-10";
                            else if (isCorrectOpt) cls = "border-success bg-success bg-opacity-10";

                            <div class="p-2 mb-2 rounded border @cls">
                                @opt.Text
                                @if (wasSelected && isCorrectOpt)
                                {
                                    <i class="bi bi-check-circle-fill text-success ms-2"></i>
                                    <small class="text-success ms-1">(Vase odpoved - spravne)</small>
                                }
                                else if (wasSelected && !isCorrectOpt)
                                {
                                    <i class="bi bi-x-circle-fill text-danger ms-2"></i>
                                    <small class="text-danger ms-1">(Vase odpoved - spatne)</small>
                                }
                                else if (isCorrectOpt)
                                {
                                    <i class="bi bi-check-circle text-success ms-2"></i>
                                    <small class="text-success">(Spravna odpoved)</small>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #dee2e6;"></i>
                    <p class="text-muted mt-3">Zaznam nebyl nalezen.</p>
                </div>
            }
        </div>
    </div>
</div>
