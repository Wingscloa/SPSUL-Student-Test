@using SPSUL.Models.Data
@using SPSUL.Models.Display.ConfigModels
@model ClassesFormEditVM

<div class="mb-3">
    <label class="configLabel small mb-1" for="Name">Název</label>
    <input type="text" class="configInput w-100" placeholder="Název" name="Name"
           value="@Model.Classes.Name"
           data-v-name="Název"
           data-v-required="true"
           data-v-reg="^[a-zA-Zá-žÁ-Ž0-9 ]+$"
           data-v-msg="Název může obsahovat písmena, čísla a musí být vyplněn."
           data-v-length="3,30"
           required>
</div>
<div class="mb-3">
    <label class="configLabel small mb-1" for="StartFrom">Rok zahájení</label>
    <input type="text" class="configInput w-100" name="StartFrom" id="editStartFrom"
           value="@Model.Classes.StartFrom.ToString()"
           inputmode="numeric"
           placeholder="RRRR"
           data-v-name="Rok"
           data-v-required="true"
           data-v-length="4,4"
           data-v-reg="^(19|20)\d{2}$"
           data-v-msg="Zadejte platný rok ve formátu RRRR (např. 2024)."
           required>
</div>
<div class="mb-3">
    <label class="configLabel small mb-1" for="EndTo">Konec studia</label>
    <input type="text" class="configInput w-100" name="EndTo" id="editEndTo" required
           value="@Model.Classes.EndTo.ToString()"
           inputmode="numeric"
           placeholder="RRRR"
           data-v-name="Rok"
           data-v-required="true"
           data-v-length="4,4"
           data-v-reg="^(19|20)\d{2}$"
           data-v-msg="Zadejte platný rok ve formátu RRRR (např. 2024).">
</div>
<div class="mb-3">
    <label class="configLabel small mb-1" for="StudentFieldIds">Obory</label>
    <input type="hidden" name="StudentFieldIds" value="" />
    <select class="form-select select2" multiple="multiple" name="StudentFieldIds" autocomplete="off"
            data-v-name="Předměty"
            data-v-required="true"
            data-v-length="1,@Model.StudentFields.Count"
            data-v-msg="Vyberte prosím alespoň jednu roli. (maximálně @Model.StudentFields.Count)">
        @foreach (var field in Model.StudentFields)
        {
            @if(Model.Classes.ClassesFields.Any(e => e.StudentFieldId == field.StudentFieldId))
            {
                <option value="@field.StudentFieldId" selected>@field.Name</option>
            }
            else
            {
                <option value="@field.StudentFieldId">@field.Name</option>
            }
        }
    </select>
</div>
<input type="hidden" name="ClassesId" value="@Model.Classes.ClassesId"/> 