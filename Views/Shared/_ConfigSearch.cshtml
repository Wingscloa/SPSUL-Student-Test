@model string


<div class="row g-2 ct-filters">
    <div class="col-12">
        <div class="input-container">
            <span class="searchGroup bg-white border-end-0">
                <svg style="margin-bottom: 3px; margin-left: 2px" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
            </span>
            <input type="text" class="form-control searchBar configInput border-start-0"
                   placeholder="@Model" aria-label="Hledání názvů" name="SearchFilter">
            <div class="btn-clear" aria-label="Vymazat">&times;</div>
        </div>
    </div>
</div>