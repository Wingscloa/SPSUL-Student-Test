@model string


<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="configHeader mb-0">@Model</h5>
    <div id="configMods">
        <button class="btn btn-sm" id="btnExportPdf" type="button">
            <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
        </button>
        <button class="btn btn-sm" id="btnDelete" type="button">
            <i class="bi bi-dash-circle me-1"></i> Smazat
        </button>
        <button class="btn btn-sm" id="btnCreate" type="button">
            <i class="bi bi-plus-circle me-1"></i> Nový záznam
        </button>
    </div>
    <div id="configOptions" class="d-none">
        <button class="btn btn-sm" id="configAccept" type="button">
            <i class="bi bi-plus-circle me-1"></i> Potvrdit
        </button>
        <button class="btn btn-sm" id="configCancel" type="button">
            <i class="bi bi-x-circle me-1"></i> Zrušit
        </button>
    </div>
</div>