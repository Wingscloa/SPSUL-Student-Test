@using SPSUL.Models.Data

@model IEnumerable<object>

@{
    var rows = Model?.OfType<Classes>().ToList();
}

@if (rows == null || !rows.Any())
{
    <tr>
        <td colspan="4" class="text-center text-muted py-4">
            Nic k zobrazení.
        </td>
    </tr>
    return;
}

@foreach (Classes classes in rows)
{
    <tr class="configRow"
        data-id="@classes.ClassesId"
        role="button"
        tabindex="0">
        <td class="fw-bold name-cell">@classes.Name</td>
        <td class="title-cell d-none d-md-table-cell"><span class="small">@string.Join(", ", classes.ClassesFields.Select(e => e.StudentField.Name))</span></td>
        <td class="d-none d-sm-table-cell text-muted">@classes.StartFrom</td>
        <td class="d-none d-sm-table-cell text-muted">@classes.EndTo</td>
        <td class="text-center">
            <i class="bi bi-pencil-square text-orange iconEdit" aria-hidden="true"></i>
            <i class="bi bi-trash d-none iconDelete" style="color:#FF7070;" aria-hidden="true"></i>
        </td>
    </tr>
}