@model string?
<div class="username">
    <p>
        @(string.IsNullOrEmpty(Model) ? "Host" : Model)
    </p>
</div>
<div class="d-flex align-items-center">
    <div class="profile me-2 ms-3" data-bs-toggle="modal" data-bs-target="#configModal" aria-label="Profil">
        <i class="bi bi-person-circle" aria-hidden="true"></i>
    </div>
</div>