@model string?

<div class="user-info">
    <div class="user-details">
        <span class="user-name">
            @(string.IsNullOrEmpty(Model) ? "Host" : Model)
        </span>
        <span class="user-role">Učitel</span>
    </div>
    <div class="user-avatar" data-bs-toggle="modal" data-bs-target="#configModal" 
         aria-label="Profil" title="Otevřít profil" style="cursor: pointer;">
        <i class="bi bi-person-workspace"></i>
    </div>
</div>