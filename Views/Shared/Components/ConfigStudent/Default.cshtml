@using SPSUL.Models.Data
@using SPSUL.Models.Display
@using SPSUL.Models.Display.ConfigModels
@using SPSUL.ViewComponents
@model ConfigStudentViewModel

@{
    StudentFormCreateVM createModel = new StudentFormCreateVM
    {
        Classes = Model.Classes
    };
}

<div class="d-flex flex-column h-100 ct-wrapper" id="ctRoot">
    <div class="p-3 bg-light border-bottom flex-shrink-0">
        @await Html.PartialAsync("_ConfigHeader", "Správa studentů")
        <form id="filterForm" novalidate>
            @await Html.PartialAsync("_ConfigSearch", "Hledej název")
            <div class="row g-2 ct-filters" style="margin-top: 2px">
                <div class="col-12 col-md-6">
                    <select class="form-select configInput select2" multiple id="titleFilter" name="TitleFilterIds" 
                            aria-label="Filtr titulů" data-v-placeholder="Třída">
                        @foreach (var classes in Model.Classes)
                        {
                            <option value="@classes.ClassesId">@classes.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <select class="form-select configInput select2" id="activeFilter" name="ActiveFilter" aria-label="Filtr titulů">
                        <option selected disabled>Všechny aktivní/neaktivní</option>
                        <option value="on">Aktivní</option>
                        <option value="off">Neaktivní</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
    <div class="row g-0 flex-grow-1 overflow-hidden" style="min-height:0;">
        <!-- LIST -->
        <div class="col-12 d-flex flex-column h-100 overflow-hidden order-1 ct-list" id="list">
            @await Html.PartialAsync("TableContent/_TableContent", Model.Students)
        </div>

        <!-- Editace v offcanvasu #ctEditor -->
    </div>
</div>


<input type="hidden" id="deleteIds" value="" />
<input type="hidden" id="filterUrl" value="/api/student/content/" />
<input type="hidden" id="crudURL" value="/api/student" />
<input type="hidden" id="DeleteUrl" value="/api/student/delete/" />
<input type="hidden" id="EditForm" value="/api/Config/StudentEditForm/" />
<input type="hidden" id="CreateForm" value="/api/Config/StudentCreateForm/" />