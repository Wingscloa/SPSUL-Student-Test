@using SPSUL.ViewComponents
@model ConfigProfileViewModel

<div class="ConfigContent">
    <p class="ContentHeader">Údaje o profilu</p>
    <form id="profileForm">
        <div class="row ms-1">
            <div class="col-12 col-md-6">
                <label class="configLabel" for="profileFirstName">
                    <span class="bi bi-person-circle me-1"></span>Křestní jméno
                </label>
                <input class="configInput" autocomplete="off" value="@Model.Teacher.FirstName"
                       name="FirstName" id="profileFirstName"
                       data-v-name="Křestní jméno" data-v-required="true"
                       data-v-reg="^[a-zA-Zá-žÁ-Ž ]+$"
                       data-v-msg="Jméno musí obsahovat pouze písmena." />
            </div>
        </div>
        <div class="row ms-1 mt-3">
            <div class="col-12 col-md-6">
                <label class="configLabel" for="profileLastName">
                    <span class="bi bi-person-circle me-1"></span>Příjmení
                </label>
                <input class="configInput" autocomplete="off" value="@Model.Teacher.LastName"
                       name="LastName" id="profileLastName"
                       data-v-name="Příjmení" data-v-required="true"
                       data-v-reg="^[a-zA-Zá-žÁ-Ž ]+$"
                       data-v-msg="Příjmení musí obsahovat pouze písmena." />
            </div>
        </div>
        <div class="row ms-1 mt-3">
            <div class="col-12 col-md-6">
                <label class="configLabel" for="profileNickName">
                    <span class="bi bi-at me-1"></span>Přezdívka
                </label>
                <input class="configInput" autocomplete="off" value="@Model.Teacher.NickName"
                       name="NickName" id="profileNickName"
                       data-v-name="Přezdívka" data-v-required="true"
                       data-v-msg="Přezdívka je povinná." />
            </div>
        </div>
        <div class="row ms-1 mt-4">
            <div class="col-12">
                <p class="ContentHeader" style="font-size:1rem;">Změna hesla <small class="text-muted fw-normal">(volitelné)</small></p>
            </div>
        </div>
        <div class="row ms-1">
            <div class="col-12 col-md-6">
                <label class="configLabel" for="profileNewPassword">
                    <span class="bi bi-lock me-1"></span>Nové heslo
                </label>
                <input class="configInput" type="password" autocomplete="new-password"
                       name="NewPassword" id="profileNewPassword"
                       placeholder="Ponechte prázdné pokud nechcete měnit" />
            </div>
        </div>
        <div class="row ms-1 mt-3 mb-3">
            <div class="col-12 col-md-6">
                <button class="configButton w-100" type="button" id="btnSaveProfile">
                    <i class="bi bi-check2-circle me-1"></i> Uložit změny
                </button>
            </div>
        </div>
    </form>
</div>
<div class="modalBreakGrey mt-2"></div>
<div class="ConfigContent">
    <p class="ContentHeader">Oprávnění</p>
    <table class="permissionTable">
        <tr class="tableHeaders">
            <th class="col-2">Oprávnění</th>
            <th class="col-1">Povolení</th>
            <th class="col-6">Popis</th>
        </tr>
        @foreach (var role in Model.Roles)
        {
            bool isAssigned = Model.Teacher.TeacherRoles is not null ? Model.Teacher.TeacherRoles.Any(e => e.RoleId == role.RoleId) : false;
            <tr class="tableRow @(isAssigned ? "" : "disabled")">
                <td>@role.Name</td>
                <td>
                    <label class="switch" for="@role.Name">
                        <input type="checkbox" id="@role.Name" @(isAssigned ? "checked" : "") disabled />
                        <div class="slider round"></div>
                    </label>
                </td>
                <td>@role.Description</td>
            </tr>
        }
    </table>
</div>

<script src="~/js/config/profile.js" asp-append-version="true"></script>
