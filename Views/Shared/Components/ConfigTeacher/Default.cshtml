@using SPSUL.Models.Data
@using SPSUL.Models.Display
@using SPSUL.Models.Display.ConfigModels
@using SPSUL.ViewComponents
@model ConfigTeacherModel

@{
    TeacherFormCreateVM createModel = new TeacherFormCreateVM
    {
        Titles = Model.Titles,
        Roles = Model.Roles
    };
}

<div class="d-flex flex-column h-100 ct-wrapper" id="ctRoot">
    <div class="p-3 bg-light border-bottom flex-shrink-0">
        @await Html.PartialAsync("_ConfigHeader", "Správa učitelů")
        <form id="filterForm" novalidate>
            @await Html.PartialAsync("_ConfigSearch", "Hledej název")
            <div class="row g-2 ct-filters" style="margin-top: 2px">
                <div class="col-12 col-md-4">
                    <select class="form-select configInput select2" multiple id="titleFilter" name="TitleFilterIds" aria-label="Filtr titulů">
                        @foreach(var title in Model.Titles)
                        {
                            <option value="@title.TitleId">@title.Shortcut</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <select class="form-select configInput select2" multiple id="roleFilter" name="RoleFilterIds" aria-label="Filtr Rolí">
                        @foreach(var role in Model.Roles)
                        {
                            <option value="@role.RoleId">@role.Name</option>
                        })
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <select class="form-select configInput select2" id="activeFilter" name="ActiveFilter" aria-label="Filtr titulů">
                        <option selected disabled>Všechny aktivní/neaktivní</option>
                        <option value="on">Aktivní</option>
                        <option value="off">Neaktivní</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
    <div class="row g-0 flex-grow-1 overflow-hidden" style="min-height:0;">
        <!-- LIST -->
        <div class="col-12 d-flex flex-column h-100 overflow-hidden order-1 ct-list" id="list">
            @if(Model.Teachers.Items == null)
            {
                
            }
            else
            {
                @await Html.PartialAsync("TableContent/_TableContent", Model.Teachers)
            }
        </div>

        <!-- Editace v offcanvasu #ctEditor -->
    </div>
</div>


<input type="hidden" id="deleteIds" value="" />
<input type="hidden" id="filterUrl" value="/api/teacher/content/"/>
<input type="hidden" id="pdfUrl" value="/api/pdf/teachers" />
<input type="hidden" id="crudURL" value="/api/teacher"/>
<input type="hidden" id="DeleteUrl" value="/api/teacher/delete/"/>
<input type="hidden" id="EditForm" value="/api/Config/TeacherEditForm/"/>
<input type="hidden" id="CreateForm" value="/api/Config/TeacherCreateForm/"/>