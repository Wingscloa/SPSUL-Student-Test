                            <th class="py-3 text-uppercase small text-muted">Hodnota</th>
                            <th class="py-3 text-uppercase small text-muted text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-4 fw-bold">Název systému</td>
                            <td>Systém pro tvoření testu SPSUL</td>
                            <td class="text-end pe-4"><i class="bi bi-check-circle-fill text-success"></i></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">Poslední sestavení</td>
                            <td>20. 01. 2026 23:39</td>
                            <td class="text-end pe-4"><span class="badge bg-light text-dark border">Build #1</span></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">Prostředí</td>
