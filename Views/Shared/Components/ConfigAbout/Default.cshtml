                            <td class="text-end pe-4"><i class="bi bi-shield-lock"></i></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">Podpora</td>
                            <td>it-podpora@spsul.cz</td>
                            <td class="text-end pe-4"><a href="#" class="btn btn-xs btn-link p-0">Kontakt</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
