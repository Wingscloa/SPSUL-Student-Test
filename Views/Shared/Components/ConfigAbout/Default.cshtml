        <div class="col-12 col-lg-5 d-flex flex-column h-100 bg-white order-2 ct-form overflow-auto" id="editDesktop">
            <div class="p-4 flex-grow-1 ct-scroll">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="configLabel mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        <span>Detailní popis</span>
                    </h6>
                </div>

                <div class="about-content">
                    <p class="text-muted">
                        Tento modul slouží pro správu testu a otázek.
                    </p>
                    <hr />
                    <label class="form-label small text-muted fw-bold">Technologický stack</label>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            ASP.NET Core Runtime <span class="text-dark">8.0</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Entity Framework Core <span class="text-dark">8.x</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Microsoft SQL Server <span class="text-dark">2019+</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            Bootstrap Framework <span class="text-dark">v5.3</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
