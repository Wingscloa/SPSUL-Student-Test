                    </div>
                </div>
            </div>

            <div class="border-top bg-light flex-shrink-0 d-flex ct-savebar" style="padding:7px !important">
                <a asp-controller="Config" asp-action="DownloadDocumentation"
                   class="btn btn-secondary btn-sm w-100 py-2 shadow-sm">
                    <i class="bi bi-download me-1"></i>
                    <span>Stáhnout technickou dokumentaci</span>
                </a>
            </div>
