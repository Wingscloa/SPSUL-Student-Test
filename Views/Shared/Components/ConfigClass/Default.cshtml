@using SPSUL.Models.Data
@using SPSUL.Models.Display
@using SPSUL.Models.Display.ConfigModels
@using SPSUL.ViewComponents
@model ConfigClassVM

@{
    ViewData["CanEdit"] = Context.HasAnyPermission(AppPermissions.ManageClasses, AppPermissions.All);
}

<div class="d-flex flex-column h-100 ct-wrapper" id="ctRoot">
    <div class="p-3 bg-light border-bottom flex-shrink-0">
        @await Html.PartialAsync("_ConfigHeader", "Správa třídy")
        <form id="filterForm" novalidate>
            @await Html.PartialAsync("_ConfigSearch", "Hledej název")
            <div class="row g-2 ct-filters" style="margin-top: 2px">
                <div class="col-12 col-md-3">
                    <select class="form-select configInput select2" multiple id="FieldFilterIds"
                            name="FieldFilterIds" aria-label="Filtr oborů" data-v-placeholder="Předměty">
                        @foreach (var field in Model.Fields)
                        {
                            <option value="@field.StudentFieldId">@field.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <div class="input-container">
                        <input type="number" maxlength="4" placeholder="Začátek roku (20RR)" class="form-control configInput onlyYear"
                               id="StartFromFilter" name="StartFromFilter" aria-label="Filtr začátek zahájení" data-v-originvalue="20">
                        <button type="button" class="btn-clear" aria-label="Vymazat">&times;</button>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="input-container">
                        <input type="number" maxlength="4" placeholder="Konec roku (20RR)"
                               class="form-control configInput onlyYear" id="EndToFilter" data-v-originValue="20"
                               name="EndToFilter" aria-label="Filtr konec studia">
                        <button type="button" class="btn-clear" aria-label="Vymazat">&times;</button>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select class="form-select configInput select2" id="activeFilter" name="ActiveFilter" aria-label="Filtr titulů">
                        <option selected disabled>Všechny aktivní/neaktivní</option>
                        <option value="on">Aktivní</option>
                        <option value="off">Neaktivní</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
    <div class="row g-0 flex-grow-1 overflow-hidden" style="min-height:0;">
        <!-- LIST -->
        <div class="col-12 d-flex flex-column h-100 overflow-hidden order-1 ct-list" id="list">
            @await Html.PartialAsync("TableContent/_TableContent", Model.Classes)
        </div>

        <!-- Editace v offcanvasu #ctEditor -->
    </div>
</div>


<input type="hidden" id="deleteIds" value="" />
<input type="hidden" id="filterUrl" value="/api/classes/content/" />
<input type="hidden" id="pdfUrl" value="/api/pdf/classes" />
<input type="hidden" id="crudURL" value="/api/classes" />
<input type="hidden" id="DeleteUrl" value="/api/classes/delete/" />
<input type="hidden" id="EditForm" value="/api/Config/ClassesEditForm/" />
<input type="hidden" id="CreateForm" value="/api/Config/ClassesCreateForm/" />