@using SPSUL.Models.Display.QuestionForm

@model List<OptionBase>

@foreach(OptionBase opt in Model)
{
    var number = Model.IndexOf(opt) + 1;
    <div class="card mb-2 option-card @(opt.IsCorrect ? "correct" : "")" data-option-index="@opt.Index">
        <div class="card-body p-3" style="position:relative">
            <div class="form-check">
                <input @(number == 1 ? "checked" : "") class="form-check-input" name="CorrectInput" type="checkbox" id="isCorrect_@opt.Index">
                <label class="form-check-label fw-bold text-success" for="isCorrect_@opt.Index">
                    Správná
                </label>
            </div>
            <div class="mt-1">
                <label class="form-label small mb-1">Nadpis</label>
                <input type="text" name="optionText" class="form-control option-text" maxlength="32" value="dwakdawkd" data-index="@opt.Index" placeholder="Nadpis @number"
                       data-default="Nadpis @number" required>
            </div>
            <div class="mt-1">
                <label class="form-label small mb-1">Obrázek</label>
                <input type="file" name="imageQuestion" accept="image/*" class="form-control option-text" data-index="@opt.Index" required>
            </div>
        </div>
        <div>
            <div class="questionRemove" role="button" aria-label="Odstranit">
                <span class="cross-line"></span>
            </div>
        </div>
    </div>
}