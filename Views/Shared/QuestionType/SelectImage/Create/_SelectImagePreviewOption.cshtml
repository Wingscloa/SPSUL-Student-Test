@using SPSUL.Models.Display.QuestionForm

@model List<OptionBase>

@* CREATE *@

@foreach(OptionBase opt in Model)
{
    <label class="radio-option @(opt.IsCorrect ? "correct" : "")" data-option-index="@opt.Index">
        <input type="radio" name="preview_answer" value="0" disabled>
        <span class="radio-label">@opt.PlaceHolder) Možnost @opt.PlaceHolder</span>
    </label>
}
