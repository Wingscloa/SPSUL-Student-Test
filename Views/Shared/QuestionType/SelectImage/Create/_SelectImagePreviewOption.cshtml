@using SPSUL.Models.Display.QuestionForm

@model List<OptionBase>

@* CREATE *@

@foreach(OptionBase opt in Model)
{
    <div class="imageOption optionItem-3 previewOption" data-index="@(opt.Index)" data-default="Nadpis @(opt.Index + 1)">
        <span class="imageLabel optionPreviewLabel">Nadpis @(opt.Index + 1)</span>
        <div class="imageBorder optionPreviewBorder">
            <div class="imageContainer d-none">
                <img src="" />
            </div>
            <div class="noImage">
                <h3 class="text-muted noImageTxt">Vlož obrázek</h3>
            </div>
        </div>
    </div>
}
