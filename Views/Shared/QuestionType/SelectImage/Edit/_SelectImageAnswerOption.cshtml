@using SPSUL.Models.Display.QuestionForm

@model List<OptionEdit>

@foreach (OptionEdit opt in Model)
{
    var i = Model.IndexOf(opt);
    <div class="card mb-2 option-card @(opt.IsCorrect ? "correct" : "")" data-option-index="@i">
        <div class="card-body p-3" style="position:relative">
            <div class="d-flex align-items-start gap-2">
                <div class="form-check">
                    <input class="form-check-input" @(opt.IsCorrect ? "checked" : "") name="CorrectInput" type="checkbox" id="isCorrect_@i">
                    <label class="form-check-label fw-bold text-success" for="isCorrect_@i">
                        Správná
                    </label>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label small mb-1">Text odpovědi:</label>
                    <input type="text" name="optionText" class="form-control option-text" maxlength="512"
                           data-index="@i" placeholder="Možnost @(Convert.ToChar(65 + i))" required value="@opt.Text">
                </div>
            </div>
        </div>
        <div>
            <div class="questionRemove" role="button" aria-label="Odstranit">
                <span class="cross-line"></span>
            </div>
        </div>
    </div>
}