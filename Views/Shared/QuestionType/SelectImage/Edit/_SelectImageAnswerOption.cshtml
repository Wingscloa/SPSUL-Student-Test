@using SPSUL.Models.Data;

@model List<QuestionOption>

@foreach (QuestionOption opt in Model)
{
    var idx = Model.IndexOf(opt);
    <div class="card mb-2 option-card @(opt.IsCorrect ? "correct" : "")" data-index="@idx">
        <div class="card-body p-3" style="position:relative">
            <div class="form-check">
                <input @(opt.IsCorrect ? "checked" : "") class="form-check-input" name="CorrectInput" type="checkbox" id="isCorrect_@idx">
                <label class="form-check-label fw-bold text-success" for="isCorrect_@idx">
                    Správná
                </label>
            </div>
            <div class="mt-1">
                <label class="form-label small mb-1">Nadpis</label>
                <input type="text" name="optionText" class="form-control option-text" maxlength="32" value="@opt.Text" placeholder="Nadpis @(idx+1)"
                       data-default="Nadpis @(idx+1)" required>
            </div>
            <div class="mt-1">
                <label class="form-label small mb-1">Obrázek</label>
                <input type="file" name="imageQuestion" accept="image/*" class="form-control" value="">
            </div>
        </div>
        <div>
            <div class="questionRemove" role="button" aria-label="Odstranit">
                <span class="cross-line"></span>
            </div>
        </div>
    </div>
}