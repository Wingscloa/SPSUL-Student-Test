@using SPSUL.Models.Data
@model List<QuestionOption>

@* EDIT *@

@foreach (QuestionOption option in Model)
{
    var idx = Model.IndexOf(option);
    <div class="imageOption optionItem-3 previewOption" data-index="@idx" data-default="Nadpis @(idx + 1)">
        <span class="imageLabel optionPreviewLabel">@option.Text</span>
        <div class="imageBorder optionPreviewBorder @(option.IsCorrect ? "correct" : "")">
            <div class="imageContainer @(option.ImageKey != null ? "" : "d-none")">
                <img src="@($"http://127.0.0.1:10000/devstoreaccount1/questionimage/{option.ImageKey}.webp")" />
            </div>
            <div class="noImage @(string.IsNullOrEmpty(option.ImageKey) ? "" : "d-none")">
                <h3 class="text-muted noImageTxt">Vlož obrázek</h3>
            </div>
        </div>
    </div>
}