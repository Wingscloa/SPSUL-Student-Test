@using SPSUL.Models.Data;

@model List<QuestionOption>

@foreach (QuestionOption opt in Model)
{
    var idx = Model.IndexOf(opt);
    var character = (Convert.ToChar(65 + idx));
    var placeHolder = $"{character}) Možnost {character}";

    <div class="card mb-2 option-card option @(opt.IsCorrect ? "correct" : "")" data-index="@idx">
        <div class="card-body p-3" style="position:relative">
            <div class="d-flex align-items-start gap-2">
                <div class="form-check">
                    <input class="form-check-input" name="CorrectInput" type="checkbox" id="isCorrect_@idx" @(opt.IsCorrect ? "checked" : "")>
                    <label class="form-check-label fw-bold text-success" for="isCorrect_@idx">
                        Správná
                    </label>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label small mb-1">Text odpovědi:</label>
                    <input type="text" name="optionText" class="form-control option-text" maxlength="512" placeholder="@placeHolder"
                           data-default="@placeHolder" value="@opt.Text" required>
                </div>
            </div>
        </div>
        <div>
            <div class="questionRemove" role="button" aria-label="Odstranit">
                <span class="cross-line"></span>
            </div>
        </div>
    </div>
}