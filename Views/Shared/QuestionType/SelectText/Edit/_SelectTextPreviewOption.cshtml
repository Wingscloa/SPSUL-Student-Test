@using SPSUL.Models.Data;

@model List<QuestionOption>

@foreach (QuestionOption opt in Model)
{
    var idx = Model.IndexOf(opt);
    var character = (Convert.ToChar(65 + idx));
    var placeHolder = $"{character}) Možnost {character}";

    <label class="radio-option previewOption optionPreviewBorder @(opt.IsCorrect ? "correct" : "")" 
           data-index="@idx" data-default="@placeHolder">
        <input type="radio" name="preview_answer" value="0" disabled>
        <span class="radio-label optionPreviewLabel">@opt.Text</span>
    </label>
}
