@using SPSUL.Models.Display.QuestionForm;

@model PreviewEdit

<div id="previewContainer" class="test-preview">
    <div class="questContainer">
        <h2 id="previewHeader" class="questionHeader">@Model.Header</h2>
        <h3 id="previewDescription" class="questionName">@Model.Description</h3>
        <div id="previewOptions" class="mt-4">
            <div class="radio-note">Vyber správnou odpověď</div>
            <div class="radio-group" id="previewOptionContainer">
                @await Html.PartialAsync("/Views/Shared/QuestionType/SelectText/Edit/_SelectTextPreviewOption.cshtml", Model.Options)
            </div>
        </div>
    </div>
</div>