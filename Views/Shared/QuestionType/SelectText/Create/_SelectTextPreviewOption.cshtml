@using SPSUL.Models.Display.QuestionForm

@model List<OptionBase>

@* CREATE *@

@foreach(OptionBase opt in Model)
{
    <label class="radio-option previewOption optionPreviewBorder" data-index="@opt.Index" data-default="@opt.PlaceHolder) Možnost @opt.PlaceHolder">
        <input type="radio" name="preview_answer" value="0" disabled>
        <span class="radio-label optionPreviewLabel">@opt.PlaceHolder) Možnost @opt.PlaceHolder</span>
    </label>
}
