@using SPSUL.Models.Display.QuestionForm

@model List<OptionBase>

@foreach(OptionBase opt in Model)
{
    <div class="card mb-2 option-card option" data-index="@opt.Index" >
        <div class="card-body p-3" style="position:relative">
            <div class="d-flex align-items-start gap-2">
                <div class="form-check">
                    <input class="form-check-input" name="CorrectInput" type="checkbox" id="isCorrect_@opt.Index">
                    <label class="form-check-label fw-bold text-success" for="isCorrect_@opt.Index">
                        Správná
                    </label>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label small mb-1">Text odpovědi:</label>
                    <input type="text" name="optionText" class="form-control option-text" maxlength="512" placeholder="@opt.PlaceHolder" 
                    data-default="@opt.PlaceHolder) Možnost @opt.PlaceHolder" required>
                </div>
            </div>
        </div>
        <div>
            <div class="questionRemove" role="button" aria-label="Odstranit">
                <span class="cross-line"></span>
            </div>
        </div>
    </div>
}