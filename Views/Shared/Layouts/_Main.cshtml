<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SPSUL Informační systém pro správu testů, otázek a školní agendy." />
    <title>@ViewData["Title"] - SPSUL</title>
    <!-- CSS first -->
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link href="~/lib/bootstrap/customBootstrap.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tabbar.css" asp-append-version="true" />
    <link href="~/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/select2-bootstrap-5-theme-1.3.0/dist/select2-bootstrap-5-theme.css" rel="stylesheet" />
    <link href="~/lib/toastr.js/toastr.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/Loading.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/css/configuration.css" rel="stylesheet" asp-append-version="true" />
    <!-- JS libraries -->
    <script src="~/js/loading.js" asp-append-version="true"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/ldrs/dist/auto/bouncy.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/select2/js/select2.min.js" asp-append-version="true"></script>
    <script src="~/lib/toastr.js/toastr.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/gsap/gsap.min.js" asp-append-version="true"></script>
    <link rel="shortcut icon" href="~/Image/ico.ico" />
</head>
<body>
    <div id="loader-overlay">
        <l-bouncy size="55" speed="1.75" color="#ff8a00"></l-bouncy>
        <p class="loader-text">Načítám...</p>
    </div>
    <!-- Modern Navbar -->
    <nav class="navbar navbar-expand-lg" id="mainNavbar">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" title="SPSUL - Domů">
                <img src="~/Image/logo/SPSUL.webp" width="32" height="32" alt="SPSUL logo"/>
                <img src="~/Image/logo/spsul-logo-uk.webp" class="ms-2" width="120" height="24" alt="SPSUL"/>
            </a>
            
            <!-- Desktop Navigation -->
            <div class="collapse navbar-collapse d-none d-lg-flex" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto">
                    <!-- Primary Action -->
                    <li class="nav-item">
                        <a class="nav-link PrimaryButton" asp-controller="Test" asp-action="Create" title="Vytvořit nový test">
                            <i class="bi bi-file-earmark-plus-fill"></i>
                            <span>Vytvořit test</span>
                        </a>
                    </li>
                    
                    <!-- Main Navigation -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" title="Přejít na domovskou stránku">
                            <i class="bi bi-house-fill"></i>
                            <span>Domů</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Students" asp-action="Index" title="Správa studentů">
                            <i class="bi bi-people-fill"></i>
                            <span>Studenti</span>   
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Question" asp-action="Index" title="Správa otázek">
                            <i class="bi bi-question-circle-fill"></i>
                            <span>Otázky</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Test" asp-action="Index" title="Správa testů">
                            <i class="bi bi-journal-text"></i>
                            <span>Testy</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Detail" asp-action="Index" title="Zobrazit výsledky testů">
                            <i class="bi bi-bar-chart-fill"></i>
                            <span>Výsledky</span>
                        </a>
                    </li>
                </ul>
                
                <!-- User Component -->
                @await Component.InvokeAsync("User")
            </div>
        </div>
    </nav>
    @await Component.InvokeAsync("Config")
    @RenderBody()
    
    <script src="~/js/navbar.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tabbar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_TabBar")
    <script src="~/js/configuration.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_NotificationHandler")
</body>
</html>